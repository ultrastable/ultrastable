+-- DB: qnfo-audit
+-- Rollback: DROP TRIGGER IF EXISTS owner_asks_product_profile_au; DROP TABLE IF EXISTS product_profile
+-- Rollback note: the three owner_asks rows stay as the record of what was asked.
