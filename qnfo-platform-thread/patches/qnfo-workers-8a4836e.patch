+    "app": "QNFO research and reach applications. They are the first customer of the core and leave the repository when the core is extracted.",
+    "personal": "The owner's private plane (DOMAIN-PLANE-1, q08.org). Never part of the product, never copied into it."
+  },
+  "workers": {
+    "qnfo-fleet-control":       { "class": "core", "role": "kernel: the 10-minute tick, metric triggers, loop watch, trust ledger refresh, remediation contracts", "entangled": "charter, portfolio and research-specific steps live in the same 1.4 MB file" },
+    "qnfo-code-orchestrator":   { "class": "core", "role": "code loop: issue with a code-task line to a planned, tested, merged pull request on open models" },
+    "qnfo-deploy-guard":        { "class": "core", "role": "work claims and the secret lease shared by every agent lane" },
+    "qnfo-ops":                 { "class": "core", "role": "canonical deploy (/ops/deploy) with lock, ledger and bindings; the server-side ops agent" },
+    "qnfo-ai":                  { "class": "core", "role": "model router with capability gates, fallbacks and soft budget routing" },
+    "qnfo-ai-calibration":      { "class": "core", "role": "calibrates and stress-tests every routed model endpoint" },
+    "qnfo-ai-yield":            { "class": "core", "role": "AI cost yield measurement" },
+    "qnfo-waste-agent":         { "class": "core", "role": "finds and removes spend that produces nothing" },
+    "qnfo-memory-mcp":          { "class": "core", "role": "fleet code and topology graph (blast radius) and the knowledge graph" },
+    "qnfo-observability":       { "class": "core", "role": "makes the fleet observable to itself (trace ingest into D1)" },
+    "qnfo-cloud-ops":           { "class": "core", "role": "task runner for D1 workflows, owner-step watch and probe cadence" },
+    "qnfo-github-steward":      { "class": "core", "role": "mirrors the issue ledger to GitHub and keeps issue hygiene" },
+    "qnfo-intent-orchestrator": { "class": "core", "role": "turns a request from any client into an issue the loops act on" },
+    "qnfo-tools-mcp":           { "class": "core", "role": "MCP tool server for agent clients" },
+    "qnfo-agents":              { "class": "core", "role": "Cloudflare Agents SDK runtime reachable from the console" },
+    "qnfo-containers-pilot":    { "class": "core", "role": "container executor for Python and workspace jobs" },
+    "qnfo-doc-gate":            { "class": "core", "role": "gate that keeps documents tied to code", "review": true },
+    "qnfo-infra":               { "class": "core", "role": "shared infrastructure routes", "review": true },
+    "qnfo-fleet-dashboard":     { "class": "core", "role": "operator console (fleet.qnfo.org): queue, decisions, prompted-recall questions, owner tasks", "entangled": "research pages and the private owner documents are served from the same worker" },
+
+    "qnfo-research-exec":       { "class": "app", "role": "autonomous research pipeline: ground, draft, referee, revise, publish" },
+    "idea-hub":                 { "class": "app", "role": "research idea intake and scoring" },
+    "radar-hub":                { "class": "app", "role": "research radars" },
+    "qnfo-pdf":                 { "class": "app", "role": "paper PDFs" },
+    "qnfo-ipatent":             { "class": "app", "role": "ipatent research surface" },
+    "qnfo-gateway":             { "class": "app", "role": "qnfo.org and papers.qnfo.org, the home of record" },
+    "qnfo-ai-search":           { "class": "app", "role": "ask the library" },
+    "qnfo-social":              { "class": "app", "role": "outreach posts" },
+    "qnfo-email":               { "class": "app", "role": "inbound and outbound mail" },
+    "qnfo-subscribers":         { "class": "app", "role": "paper subscriptions" },
+    "qnfo-lifecycle":           { "class": "app", "role": "reader lifecycle mail", "review": true },
+    "qnfo-youtube-shorts":      { "class": "app", "role": "research shorts" },
+
+    "personal-api":             { "class": "personal", "role": "personal companion API (me.q08.org)" },
+    "personal-companion":       { "class": "personal", "role": "personal companion" },
+    "personal-watch":           { "class": "personal", "role": "personal watch" },
+    "q08-mind":                 { "class": "personal", "role": "personal notes" },
+    "q08-prediction-markets":   { "class": "personal", "role": "personal markets view" },
+    "q08-signal-engine":        { "class": "personal", "role": "personal signals" },
+    "qnfo-jobsearch":           { "class": "personal", "role": "the owner's job search (jobs.q08.org)" },
+    "qnfo-companion-guard":     { "class": "personal", "role": "guard for the personal companion", "review": true }
+  },
+  "core_scripts": [
+    "scripts/canary_revert.py",
+    "scripts/deploy_probes.py",
+    "scripts/review_gate.py",
+    "scripts/fleet_graph.mjs",
+    "scripts/run-suites.mjs",
+    "scripts/worker_release.py",
+    "scripts/apply_migrations.py",
+    "scripts/remediation_consumer.py",
+    "scripts/worker_outline.py",
+    "scripts/product_boundary.mjs"
+  ],
+  "core_workflows": [
+    ".github/workflows/canonical-deploy.yml",
