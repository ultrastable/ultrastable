+    "decision_predictions", "decision_outcomes", "failure_modes", "spof_registry", "belief_registry",
+    "blocker_redteam", "capability_ledger", "doctrine_proposals", "false_stop_register",
+    "control_registry", "owner_asks", "human_actions"
+  ],
+  "phases": [
+    { "id": "P0", "what": "This manifest and its check: every live worker is classified, so new code lands on one side.", "state": "done" },
+    { "id": "P1", "what": "A short default policy pack (the agreement every agent lane reads) extracted from CLAUDE.md and the doctrine; QNFO keeps its owner directives as an overlay.", "state": "open" },
+    { "id": "P2", "what": "Core tables move from qnfo-audit into their own D1 database; QNFO tables stay. The kernel reads core tables only.", "state": "open" },
+    { "id": "P3", "what": "Tenant settings (account, repository, hosts, model ladder, owner contact) read from configuration instead of constants.", "state": "open" },
+    { "id": "P4", "what": "A second installation on a repository outside qnfo-workers proves the core runs without QNFO's applications.", "state": "open" }
+  ]
