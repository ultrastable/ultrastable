{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/rules.schema.json",
 "title": "rules.json",
 "description": "Inferred from rules.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "interval_h": {
   "type": "integer"
  },
  "notice_pattern": {
   "type": "string"
  },
  "org": {
   "type": "string"
  },
  "pages_live_urls": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "qnfo_exempt_globs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "qnfo_live_origin": {
   "type": "string"
  },
  "qnfo_live_pages": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "qnfo_scan_globs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "repos": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "ci": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "gaps": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "id": {
      "type": "string"
     },
     "runtime": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "source": {
      "type": "string"
     },
     "statement": {
      "type": "string"
     }
    },
    "required": [
     "ci",
     "id",
     "runtime",
     "source",
     "statement"
    ]
   }
  },
  "secret_exempt_globs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "secret_patterns": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "version": {
   "type": "string"
  },
  "workflows": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "_doc",
  "interval_h",
  "notice_pattern",
  "org",
  "pages_live_urls",
  "qnfo_exempt_globs",
  "qnfo_live_origin",
  "qnfo_live_pages",
  "qnfo_scan_globs",
  "repos",
  "rules",
  "secret_exempt_globs",
  "secret_patterns",
  "version",
  "workflows"
 ]
}
