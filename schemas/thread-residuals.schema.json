{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/thread-residuals.schema.json",
 "title": "thread-residuals.json",
 "description": "Inferred from thread-residuals.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "residuals": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "key": {
      "type": "string"
     },
     "thread": {
      "type": "string"
     }
    },
    "required": [
     "key",
     "thread"
    ]
   }
  }
 },
 "required": [
  "_doc",
  "residuals"
 ]
}
