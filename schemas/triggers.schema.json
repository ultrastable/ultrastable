{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/triggers.schema.json",
 "title": "triggers.json",
 "description": "Inferred from triggers.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "events": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "actions": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "event": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "when": {
      "type": "string"
     },
     "why": {
      "type": "string"
     }
    },
    "required": [
     "event",
     "id",
     "role",
     "why"
    ]
   }
  },
  "heartbeat": {
   "type": "object",
   "properties": {
    "cron": {
     "type": "string"
    },
    "why": {
     "type": "string"
    }
   }
  },
  "host_limits": {
   "type": "object",
   "properties": {
    "max_crons_per_worker": {
     "type": "integer"
    },
    "max_role_period_minutes": {
     "type": "integer"
    },
    "max_ticks_per_day": {
     "type": "integer"
    },
    "min_interval_minutes": {
     "type": "integer"
    }
   }
  },
  "workflow_max_fires_per_day": {
   "type": "integer"
  },
  "workflows": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "crons": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "events": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "crons",
     "events"
    ]
   }
  }
 },
 "required": [
  "_doc",
  "events",
  "heartbeat",
  "host_limits",
  "workflow_max_fires_per_day",
  "workflows"
 ]
}
