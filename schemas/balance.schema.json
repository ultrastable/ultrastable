{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/balance.schema.json",
 "title": "balance.json",
 "description": "Inferred from balance.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_batch_exclude_doc": {
   "type": "string"
  },
  "_doc": {
   "type": "string"
  },
  "batch_exclude": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "batch_threshold": {
   "type": "integer"
  },
  "batch_window_days": {
   "type": "integer"
  },
  "boost": {
   "type": "object",
   "properties": {
    "max": {
     "type": "integer"
    },
    "normal": {
     "type": "integer"
    },
    "tipped": {
     "type": "integer"
    }
   }
  },
  "counts_as_closure": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "family": {
   "type": "string"
  },
  "final_statuses": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "max_supersede_per_pass": {
   "type": "integer"
  },
  "never_closure": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sla_days": {
   "type": "object",
   "properties": {
    "default": {
     "type": "integer"
    },
    "p0": {
     "type": "integer"
    },
    "p1": {
     "type": "integer"
    }
   }
  },
  "throttle": {
   "type": "object",
   "properties": {
    "daily_quota_floor": {
     "type": "integer"
    },
    "quota_share_of_weekly_outflow": {
     "type": "number"
    }
   }
  },
  "version": {
   "type": "string"
  },
  "windows": {
   "type": "object",
   "properties": {
    "day": {
     "type": "integer"
    },
    "week": {
     "type": "integer"
    }
   }
  }
 },
 "required": [
  "_batch_exclude_doc",
  "_doc",
  "batch_exclude",
  "batch_threshold",
  "batch_window_days",
  "boost",
  "counts_as_closure",
  "family",
  "final_statuses",
  "max_supersede_per_pass",
  "never_closure",
  "sla_days",
  "throttle",
  "version",
  "windows"
 ]
}
