{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/tenant-storage.schema.json",
 "title": "tenant-storage.json",
 "description": "Inferred from tenant-storage.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "decision": {
   "type": "object",
   "properties": {
    "aggregates": {
     "type": "string"
    },
    "blobs": {
     "type": "string"
    },
    "control_plane": {
     "type": "string"
    },
    "hot_reads": {
     "type": "string"
    },
    "portable": {
     "type": "string"
    },
    "store": {
     "type": "string"
    },
    "vectors": {
     "type": "string"
    }
   }
  },
  "default_budget": {
   "type": "object",
   "properties": {
    "day": {
     "type": "object",
     "properties": {
      "reads": {
       "type": "integer"
      },
      "requests": {
       "type": "integer"
      },
      "writes": {
       "type": "integer"
      }
     }
    },
    "max_storage_bytes": {
     "type": "integer"
    },
    "max_vectors": {
     "type": "integer"
    },
    "month": {
     "type": "object",
     "properties": {
      "reads": {
       "type": "integer"
      },
      "requests": {
       "type": "integer"
      },
      "writes": {
       "type": "integer"
      }
     }
    },
    "per_query_reads": {
     "type": "integer"
    }
   }
  },
  "migration": {
   "type": "object",
   "properties": {
    "evidence": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "action": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "owner": {
        "type": "string"
       },
       "probe": {
        "type": "string"
       },
       "title": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "id",
       "owner",
       "probe",
       "title"
      ]
     }
    },
    "target": {
     "type": "string"
    }
   }
  },
  "monthly_ceiling_usd": {
   "type": "integer"
  },
  "plan_base_usd": {
   "type": "integer"
  },
  "price_as_of": {
   "type": "string"
  },
  "tenants": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "wave": {
      "type": "integer"
     }
    },
    "required": [
     "id",
     "kind",
     "source",
     "wave"
    ]
   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "decision",
  "default_budget",
  "migration",
  "monthly_ceiling_usd",
  "plan_base_usd",
  "price_as_of",
  "tenants",
  "version"
 ]
}
