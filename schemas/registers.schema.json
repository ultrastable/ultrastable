{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/registers.schema.json",
 "title": "registers.json",
 "description": "Inferred from registers.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "controls": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "alternate": {
      "type": "string"
     },
     "critical_path": {
      "type": "boolean"
     },
     "disposition": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "probe": {
      "type": "string"
     },
     "replacement": {
      "type": "string"
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "alternate",
     "critical_path",
     "disposition",
     "id",
     "kind",
     "note",
     "probe",
     "what"
    ]
   }
  },
  "failure_modes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "blast_radius": {
      "type": "string"
     },
     "cadence_ticks": {
      "type": "integer"
     },
     "detection": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "probe": {
      "type": "string"
     },
     "remediation": {
      "type": "string"
     },
     "root_cause": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "symptom": {
      "type": "string"
     },
     "trigger": {
      "type": "string"
     }
    },
    "required": [
     "blast_radius",
     "cadence_ticks",
     "detection",
     "id",
     "probe",
     "remediation",
     "root_cause",
     "status",
     "symptom",
     "trigger"
    ]
   }
  },
  "spofs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "backlog": {
      "type": "object",
      "properties": {
       "owner": {
        "type": "string"
       },
       "trigger": {
        "type": "string"
       },
       "verification": {
        "type": "string"
       }
      }
     },
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "owner": {
      "type": "string"
     },
     "probe": {
      "type": "string"
     },
     "remediation": {
      "type": "string"
     },
     "second_path_exercised": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "trigger": {
      "type": "string"
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "kind",
     "owner",
     "probe",
     "remediation",
     "second_path_exercised",
     "status",
     "trigger",
     "what"
    ]
   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "controls",
  "failure_modes",
  "spofs",
  "version"
 ]
}
