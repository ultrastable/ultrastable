{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/knobs.schema.json",
 "title": "knobs.json",
 "description": "Inferred from knobs.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "knobs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "file": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "keep_if": {
      "type": "string"
     },
     "max": {
      "type": "number"
     },
     "metric": {
      "type": "string"
     },
     "min": {
      "type": "number"
     },
     "owner": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "step": {
      "type": "number"
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "file",
     "id",
     "keep_if",
     "max",
     "metric",
     "min",
     "owner",
     "path",
     "step",
     "what"
    ]
   }
  },
  "min_days_between_changes": {
   "type": "integer"
  },
  "review_after_days": {
   "type": "integer"
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "knobs",
  "min_days_between_changes",
  "review_after_days",
  "version"
 ]
}
