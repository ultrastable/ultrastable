{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/competitors.schema.json",
 "title": "competitors.json",
 "description": "Inferred from competitors.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "cadence_days": {
   "type": "integer"
  },
  "capabilities": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "component": {
      "type": "string"
     },
     "gap": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "ours": {
      "type": "string"
     },
     "rx": {
      "type": "string"
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "component",
     "id",
     "ours",
     "rx",
     "what"
    ]
   }
  },
  "competitors": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "object"
      }
     }
    },
    "required": [
     "id",
     "name",
     "sources"
    ]
   }
  },
  "max_experiments_per_run": {
   "type": "integer"
  },
  "metric_for": {
   "type": "object",
   "properties": {
    "default": {
     "type": "string"
    },
    "existing-repo-adoption": {
     "type": "string"
    },
    "idea-to-deploy": {
     "type": "string"
    },
    "mcp-server": {
     "type": "string"
    }
   }
  },
  "min_competitors": {
   "type": "integer"
  },
  "stall_days": {
   "type": "integer"
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "cadence_days",
  "capabilities",
  "competitors",
  "max_experiments_per_run",
  "metric_for",
  "min_competitors",
  "stall_days",
  "version"
 ]
}
