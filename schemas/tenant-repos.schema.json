{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/tenant-repos.schema.json",
 "title": "tenant-repos.json",
 "description": "Inferred from tenant-repos.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "org": {
   "type": "string"
  },
  "tenants": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "ai": {
      "type": "boolean"
     },
     "description": {
      "type": "string"
     },
     "frontend": {
      "type": "string"
     },
     "keep_in_core": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "repo": {
      "type": "string"
     },
     "sandbox": {
      "type": "object",
      "properties": {
       "budget": {
        "type": "object"
       },
       "secrets": {
        "type": "array"
       },
       "stores": {
        "type": "array"
       }
      },
      "required": [
       "budget",
       "secrets",
       "stores"
      ]
     },
     "source": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "vendor": {
      "type": "object",
      "properties": {
       "doctrine/models.json": {
        "type": "string"
       },
       "doctrine/stakeholders.json": {
        "type": "string"
       },
       "seed/worker/src/knowledge.js": {
        "type": "string"
       },
       "seed/worker/src/promoqueue.js": {
        "type": "string"
       },
       "workers/core/datagraph/index.js": {
        "type": "string"
       }
      }
     },
     "visibility": {
      "type": "string"
     },
     "why": {
      "type": "string"
     },
     "worker": {
      "type": "string"
     },
     "write": {
      "type": "object",
      "properties": {
       "AGENTS.md": {
        "type": "string"
       },
       "package.json": {
        "type": "object"
       }
      },
      "required": [
       "AGENTS.md",
       "package.json"
      ]
     }
    },
    "required": [
     "repo",
     "state"
    ]
   }
  },
  "visitor_apps": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "base_manifest": {
     "type": "string"
    },
    "full_stack_hours": {
     "type": "integer"
    },
    "max_apps": {
     "type": "integer"
    },
    "max_deploys_per_run": {
     "type": "integer"
    },
    "repo_prefix": {
     "type": "string"
    },
    "template": {
     "type": "string"
    },
    "usd_per_month": {
     "type": "integer"
    },
    "visibility": {
     "type": "string"
    }
   }
  }
 },
 "required": [
  "_doc",
  "org",
  "tenants",
  "visitor_apps"
 ]
}
