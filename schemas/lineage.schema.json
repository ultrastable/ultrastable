{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/lineage.schema.json",
 "title": "lineage.json",
 "description": "Inferred from lineage.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "channels": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "drafts": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "long": {
      "type": "string"
     },
     "text": {
      "type": "string"
     }
    }
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  },
  "nodes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "label",
     "what"
    ]
   }
  }
 },
 "required": [
  "_doc",
  "channels",
  "drafts",
  "edges",
  "nodes"
 ]
}
