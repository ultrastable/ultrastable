      }
     },
     "op": {
      "type": "string"
     },
     "owner": {
      "type": "string"
     },
     "reader": {
      "type": "string"
     },
     "threshold": {
      "type": "number"
     },
     "why": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "kind",
     "levers",
     "op",
     "owner",
     "reader",
     "threshold",
     "why"
    ]
   }
  },
  "min_move_share": {
   "type": "number"
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "efficacy_days",
  "metrics",
  "min_move_share",
  "version"
 ]
}
