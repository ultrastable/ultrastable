{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/metric-loop.schema.json",
 "title": "metric-loop.json",
 "description": "Inferred from metric-loop.json; tighten by hand.",
 "type": "object",
