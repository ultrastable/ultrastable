{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/crosswalk.schema.json",
 "title": "crosswalk.json",
 "description": "Inferred from crosswalk.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "avoided": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "also_heard": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "canonical": {
      "type": "string"
     },
     "means": {
      "type": "string"
     },
     "not": {
      "type": "string"
     },
     "say": {
      "type": "string"
     }
    },
    "required": [
     "also_heard",
     "canonical",
     "means",
     "not",
     "say"
    ]
   }
  },
  "instruction_files": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "marker": {
   "type": "string"
  },
  "marker_text": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "avoided",
  "entries",
  "instruction_files",
  "marker",
  "marker_text"
 ]
}
