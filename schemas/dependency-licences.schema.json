{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/dependency-licences.schema.json",
 "title": "dependency-licences.json",
 "description": "Inferred from dependency-licences.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "checked": {
   "type": "string"
  },
  "inventory": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "eco": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "spdx": {
      "type": "string"
     },
     "use": {
      "type": "string"
     },
     "verdict": {
      "type": "string"
     },
     "where": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "eco",
     "name",
     "spdx",
     "use",
     "verdict",
     "where"
    ]
   }
  },
  "licences": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "note": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "spdx": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "spdx"
    ]
   }
  },
  "policy": {
   "type": "object",
   "properties": {
    "shipped": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tool": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 },
 "required": [
  "_doc",
  "checked",
  "inventory",
  "licences",
  "policy"
 ]
}
