{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/rootcauses.schema.json",
 "title": "rootcauses.json",
 "description": "Inferred from rootcauses.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "classes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "guard": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "match": {
      "type": "object",
      "properties": {
       "ids": {
        "type": "array"
       },
       "kinds": {
        "type": "array"
       },
       "modes": {
        "type": "array"
       },
       "text": {
        "type": "array"
       }
      }
     },
     "owner": {
      "type": "string"
     },
     "remedy": {
      "type": "string"
     },
     "root": {
      "type": "string"
     }
    },
    "required": [
     "guard",
     "id",
     "match",
     "owner",
     "remedy",
     "root"
    ]
   }
  },
  "escalate_days": {
   "type": "integer"
  },
  "quiet_days": {
   "type": "integer"
  },
  "version": {
   "type": "string"
  },
  "window_days": {
   "type": "integer"
  }
 },
 "required": [
  "_doc",
  "classes",
  "escalate_days",
  "quiet_days",
  "version",
  "window_days"
 ]
}
