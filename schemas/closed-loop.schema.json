{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/closed-loop.schema.json",
 "title": "closed-loop.json",
 "description": "Inferred from closed-loop.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "axiom": {
   "type": "string"
  },
  "excused_by": {
   "type": "string"
  },
  "fleet": {
   "type": "object",
   "properties": {
    "file": {
     "type": "string"
    }
   }
  },
  "gate_loops_allowed": {
   "type": "array"
  },
  "human_dependency": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "patterns": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "id",
     "patterns"
    ]
   }
  },
  "id": {
   "type": "string"
  },
  "instruction_files": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "lint_exempt": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "lint_scan": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "marker": {
   "type": "string"
  },
  "prompt_sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "axiom",
  "excused_by",
  "fleet",
  "gate_loops_allowed",
  "human_dependency",
  "id",
  "instruction_files",
  "lint_exempt",
  "lint_scan",
  "marker",
  "prompt_sources",
  "rules",
  "version"
 ]
}
