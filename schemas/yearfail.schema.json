 "title": "yearfail.json",
 "description": "Inferred from yearfail.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "months": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "area": {
      "type": "string"
     },
     "failure": {
      "type": "string"
     },
     "item": {
      "type": "string"
     },
     "scenario": {
      "type": [
       "null",
       "string"
      ]
     },
     "why": {
      "type": "string"
     }
    },
    "required": [
     "area",
     "failure",
     "scenario"
    ]
   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "months",
  "version"
 ]
}
