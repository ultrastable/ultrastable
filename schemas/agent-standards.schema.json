{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/agent-standards.schema.json",
 "title": "agent-standards.json",
 "description": "Inferred from agent-standards.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "instruction_files": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "marker": {
   "type": "string"
  },
  "marker_text": {
   "type": "string"
  },
  "standards": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "probe": {
      "type": "string"
     },
     "proof": {
      "type": "string"
     },
     "published": {
      "type": "string"
     },
     "read": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "trigger": {
      "type": "string"
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "read",
     "source",
     "status",
     "what"
    ]
   }
  }
 },
 "required": [
  "_doc",
  "instruction_files",
  "marker",
  "marker_text",
  "standards"
 ]
}
