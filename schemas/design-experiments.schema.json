{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/design-experiments.schema.json",
 "title": "design-experiments.json",
 "description": "Inferred from design-experiments.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "experiments": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "arms": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "axis": {
      "type": "string"
     },
     "convert_on": {
      "type": "string"
     },
     "guard_metrics": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "hypothesis": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "metric": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "prediction": {
      "type": "string"
     },
     "slot": {
      "type": "string"
     },
     "started": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "surface": {
      "type": "string"
     }
    },
    "required": [
     "arms",
     "axis",
     "guard_metrics",
     "hypothesis",
     "id",
     "metric",
     "prediction",
     "status",
     "surface"
    ]
   }
  },
  "ideas": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "blast_box": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "idea": {
      "type": "string"
     },
     "promote_when": {
      "type": "string"
     }
    },
    "required": [
     "blast_box",
     "id",
     "idea",
     "promote_when"
    ]
   }
  },
  "policy": {
   "type": "object",
   "properties": {
    "after_verdict": {
     "type": "string"
    },
    "alpha": {
     "type": "number"
    },
    "axes_allowed": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "bucketing": {
     "type": "string"
    },
    "kept_when": {
     "type": "string"
    },
    "max_concurrent_per_surface": {
     "type": "integer"
    },
    "max_days": {
     "type": "integer"
    },
    "min_sample_per_arm": {
     "type": "integer"
    },
    "never_a_variant": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "no_peeking": {
     "type": "string"
    },
    "sources": {
     "type": "string"
    },
    "statuses": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "experiments",
  "ideas",
  "policy",
  "version"
 ]
}
