{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/code-agents.schema.json",
 "title": "code-agents.json",
 "description": "Inferred from code-agents.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "adapters": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "extra": {
      "type": "object",
      "properties": {
       "max_tokens": {
        "type": "integer"
       },
       "reasoning_effort": {
        "type": "string"
       }
      },
      "required": [
       "max_tokens"
      ]
     },
     "family": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "max_prompt_chars": {
      "type": "integer"
     },
     "model": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "roles": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "route": {
      "type": "string"
     },
     "secrets": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "usd_per_m_in": {
      "type": [
       "null",
       "number"
      ]
     },
     "usd_per_m_out": {
      "type": [
       "null",
       "number"
      ]
     }
    },
    "required": [
     "family",
     "id",
     "model",
     "roles",
     "route",
     "secrets",
     "usd_per_m_in",
     "usd_per_m_out"
    ]
   }
  },
  "routing": {
   "type": "object",
   "properties": {
    "author_order": {
     "type": "string"
    },
    "ensemble": {
     "type": "object",
     "properties": {
      "disjoint_families": {
       "type": "boolean"
      },
      "max_models": {
       "type": "integer"
      },
      "min_models": {
       "type": "integer"
      },
      "never_authors_family": {
       "type": "boolean"
      },
      "when": {
       "type": "string"
      }
     }
    }
   }
  }
 },
 "required": [
  "_doc",
  "adapters",
  "routing"
 ]
}
