{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/resilience.schema.json",
 "title": "resilience.json",
 "description": "Inferred from resilience.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "beat_fresh_s": {
