    "guard_tolerance": {
     "type": "number"
    },
    "measurable_guards": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "fresh_days": {
   "type": "integer"
  },
  "funnels": {
   "type": "string"
  },
  "id": {
   "type": "string"
  },
  "item": {
   "type": "object",
   "properties": {
