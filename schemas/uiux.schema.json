      "/claims": {
       "type": "string"
      },
      "/dashboard": {
       "type": "string"
      },
      "/dashboard-owner": {
       "type": "string"
      },
      "/engineers": {
       "type": "string"
      },
      "/how": {
       "type": "string"
      },
      "/live": {
       "type": "string"
      },
      "/ops": {
       "type": "string"
      },
      "/org": {
       "type": "string"
      },
      "/roadmap": {
       "type": "string"
      }
     }
    },
    "forbidden": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "copy": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "max_h1_words": {
