    },
    "workstream": {
     "type": "string"
    }
   }
  },
  "item_prefix": {
   "type": "string"
  },
  "ledger": {
   "type": "string"
  },
  "marker": {
   "type": "string"
  },
  "paths": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "baseline_min_days": {
     "type": "integer"
    },
    "drop_ratio": {
     "type": "number"
    },
    "extra": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "audience": {
        "type": "string"
       },
       "entry": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "steps": {
        "type": "array"
       }
      },
      "required": [
       "audience",
       "entry",
       "id",
       "label",
       "steps"
      ]
     }
    },
    "min_entries": {
     "type": "integer"
    },
    "stale_after_days": {
     "type": "integer"
    },
    "window_days": {
     "type": "integer"
    }
   }
  },
  "performance": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "dom_nodes": {
     "type": "integer"
    },
    "html_bytes": {
     "type": "integer"
    },
    "inline_script_bytes": {
     "type": "integer"
    },
    "live": {
     "type": "object",
     "properties": {
      "cls": {
       "type": "number"
      },
      "lcp_ms": {
       "type": "integer"
      },
      "ttfb_ms": {
       "type": "integer"
      }
     }
    }
   }
  },
  "served": {
   "type": "string"
  },
  "status": {
   "type": "string"
  },
