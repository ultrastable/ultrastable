   "type": "string"
  },
  "audit_report": {
   "type": "string"
  },
  "audits": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "a11y": {
     "type": "string"
    },
    "boundary": {
     "type": "string"
    },
    "brand": {
     "type": "string"
    },
    "claims": {
     "type": "string"
    },
    "copy": {
     "type": "string"
    },
    "design": {
     "type": "string"
    },
    "happy-path": {
     "type": "string"
    },
    "path-drop": {
     "type": "string"
    },
    "performance": {
     "type": "string"
    },
    "structure": {
     "type": "string"
    },
    "visual-drift": {
     "type": "string"
    }
   }
  },
  "baseline": {
   "type": "string"
  },
  "boundary": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "exempt_paths": {
