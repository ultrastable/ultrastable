{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/uiux.schema.json",
 "title": "uiux.json",
 "description": "Inferred from uiux.json; tighten by hand.",
 "type": "object",
 "properties": {
