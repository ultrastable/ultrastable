   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "exempt_primary": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "max_primary_actions": {
     "type": "integer"
    },
    "primary_selector": {
     "type": "string"
    },
    "single_h1": {
     "type": "boolean"
    }
   }
  },
  "surfaces": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "hosts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "schemes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tenants_from": {
     "type": "string"
    },
    "viewports": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": [
        "integer",
        "string"
       ]
      }
     }
    }
   }
  },
  "version": {
   "type": "string"
  },
  "visual": {
   "type": "object",
   "properties": {
    "_baseline_roll": {
     "type": "string"
    },
    "_doc": {
     "type": "string"
    },
    "max_baseline_days": {
     "type": "integer"
    },
    "max_elements": {
     "type": "integer"
    },
    "min_similarity": {
     "type": "number"
    },
    "tolerance_px": {
     "type": "integer"
    }
   }
  }
 },
 "required": [
  "_doc",
  "audit_report",
  "audits",
  "baseline",
  "boundary",
  "copy",
  "essential_variables",
  "experiments",
  "fresh_days",
  "funnels",
  "id",
  "item",
  "item_prefix",
  "ledger",
  "marker",
  "paths",
  "performance",
  "served",
  "status",
  "structure",
  "surfaces",
  "version",
  "visual"
 ]
}
