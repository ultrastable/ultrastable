{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/fleet.schema.json",
 "title": "fleet.json",
 "description": "Inferred from fleet.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_archived": {
   "type": "string"
  },
  "_doc": {
   "type": "string"
  },
  "copies": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "files": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "id": {
      "type": "string"
     },
     "repos": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "rule": {
      "type": "string"
     }
    },
    "required": [
     "files",
     "id",
     "repos",
     "rule"
    ]
   }
  },
  "dependencies": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string"
     },
     "on": {
      "type": "string"
     },
     "open": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
     "from",
     "on",
     "open",
     "to"
    ]
   }
  },
  "merge": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "auto_close_on_probe": {
     "type": "boolean"
    },
    "method": {
     "type": "string"
    },
    "ready_drafts": {
     "type": "boolean"
    },
    "require": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "reviews_required": {
     "type": "integer"
    },
    "skip_labels": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "wait_minutes": {
     "type": "integer"
    }
   }
  },
  "org": {
   "type": "string"
  },
  "public_read": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "reach_error": {
   "type": "string"
  },
  "repos": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "surfaces": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "how": {
      "type": "string"
     },
     "id": {
      "type": "string"
     }
    },
    "required": [
     "how",
     "id"
    ]
   }
  }
 },
 "required": [
  "_archived",
  "_doc",
  "copies",
  "dependencies",
  "merge",
  "org",
  "public_read",
  "reach_error",
  "repos",
  "surfaces"
 ]
}
