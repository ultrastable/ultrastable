{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/selftest.schema.json",
 "title": "doctrine/selftest.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "data": {
   "type": "object",
   "properties": {
    "default_max_age_h": {
     "type": "number"
    },
    "max_age_h": {
     "type": "object",
     "properties": {
      "site/feed-data.js": {
       "type": "number"
      }
     }
    },
    "exempt": {
     "type": "object",
     "properties": {}
    }
   }
  },
  "workflows": {
   "type": "object",
   "properties": {
    "repos": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "window": {
     "type": "number"
    },
    "stale_h": {
     "type": "number"
    }
   }
  }
 },
 "required": [
  "_doc",
  "data",
  "workflows"
 ]
}
