{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/providers.schema.json",
 "title": "doctrine/providers.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "canonical": {
   "type": "object",
   "properties": {
    "code": {
     "type": "string"
    },
    "direction": {
     "type": "string"
    }
   }
  },
  "layers": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "capabilities": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "providers": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "self_hosting_test": {
   "type": "object",
   "properties": {
    "claim": {
     "type": "string"
    },
    "true_when": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "today": {
     "type": "string"
    },
    "probe": {
     "type": "string"
    }
   }
  }
 },
 "required": [
  "_doc",
  "canonical",
  "capabilities",
  "layers",
  "providers",
  "self_hosting_test",
  "version"
 ]
}
