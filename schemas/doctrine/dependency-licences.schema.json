      "spdx": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     }
    }
   }
  },
  "inventory": {
   "type": "array",
   "items": {
    "type": "object"
   }
  }
 },
 "required": [
  "_doc",
  "checked",
  "inventory",
  "licences",
  "policy"
 ]
}
