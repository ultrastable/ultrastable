  "marker": {
   "type": "string"
  },
  "target_days": {
   "type": "number"
  },
  "verify_max_age_hours": {
   "type": "number"
  },
  "verify_store": {
   "type": "string"
  },
  "verify_key": {
   "type": "string"
  },
  "topology": {
   "type": "string"
  },
  "seed_deploys": {
   "type": "string"
  },
  "clocks": {
   "type": "string"
