{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/seed-lifecycle.schema.json",
 "title": "doctrine/seed-lifecycle.json",
 "type": "object",
 "properties": {
