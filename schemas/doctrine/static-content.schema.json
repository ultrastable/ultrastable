{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/static-content.schema.json",
 "title": "doctrine/static-content.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "marker": {
   "type": "string"
  },
  "max_unchanged_days": {
   "type": "number"
  },
  "max_pages": {
   "type": "number"
  },
  "exempt": {
   "type": "array",
   "items": {
    "type": "object"
   }
  }
 },
 "required": [
  "_doc",
  "exempt",
  "marker",
  "max_pages",
  "max_unchanged_days"
 ]
}
