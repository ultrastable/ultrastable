{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/research.schema.json",
 "title": "doctrine/research.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "version": {
   "type": "number"
  },
  "studies_dir": {
   "type": "string"
  },
  "papers_dir": {
   "type": "string"
  },
  "state_dir": {
   "type": "string"
  },
  "page_module": {
   "type": "string"
  },
  "perspectives": {
   "type": "object",
   "properties": {
    "economics": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "quality": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "oversight": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "safety": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "security": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "cost": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "reliability": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "systems": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "intake": {
   "type": "object",
   "properties": {
    "feed": {
     "type": "string"
    },
    "queries": {
     "type": "object",
     "properties": {
      "economics": {
       "type": "string"
      },
      "quality": {
       "type": "string"
      },
      "oversight": {
       "type": "string"
      },
      "safety": {
       "type": "string"
      },
      "security": {
       "type": "string"
      },
      "cost": {
       "type": "string"
      },
      "reliability": {
       "type": "string"
      },
      "systems": {
       "type": "string"
      }
     }
    },
    "max_intake_items": {
     "type": "number"
    },
    "min_score": {
     "type": "number"
    }
   }
  },
  "questions": {
   "type": "array",
   "items": {
    "type": "object"
   }
  }
 },
 "required": [
  "_doc",
  "intake",
  "page_module",
  "papers_dir",
  "perspectives",
  "questions",
  "state_dir",
  "studies_dir",
  "version"
 ]
}
