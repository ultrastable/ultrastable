{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/publication.schema.json",
 "title": "doctrine/publication.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "id": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "license_blob": {
   "type": "string"
  },
  "spdx": {
   "type": "string"
  },
  "required_files": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "source_suffixes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "private_data": {
   "type": "object",
   "properties": {
    "scan_suffixes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "skip_paths": {
     "type": "string"
    },
    "patterns": {
     "type": "object",
     "properties": {
      "personal_email": {
       "type": "string"
      },
      "local_path": {
       "type": "string"
      }
     }
    },
    "allow": {
     "type": "string"
    }
   }
  },
  "procedure": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "facts": {
   "type": "object",
   "properties": {
    "actions_on_private_repositories": {
     "type": "string"
    },
    "codeowners": {
     "type": "string"
    }
   }
  },
  "spdx_baseline": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "_doc",
  "facts",
  "id",
  "license_blob",
  "private_data",
  "procedure",
  "required_files",
  "source_suffixes",
  "spdx",
  "spdx_baseline",
  "version"
 ]
}
