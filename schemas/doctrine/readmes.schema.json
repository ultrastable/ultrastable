{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./doctrine/readmes.schema.json",
  "$comment": "inferred by scripts/schemas.py (OPEN-STANDARDS-1); edit freely, --gen never overwrites",
  "title": "doctrine/readmes.json",
  "type": "object",
  "properties": {
    "_doc": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_host": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_globs": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sections": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "path",
          "sections"
        ]
      }
    },
    "dynamic_prefixes": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "stale_globs": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "stale_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "pattern",
          "why"
        ]
      }
    },
    "archived_pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": [
              "string",
              "null"
            ]
          },
          "must_point_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "must_not_point_to": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "required": [
          "must_point_to",
          "repo"
        ]
      }
    }
  },
  "required": [
    "_doc",
    "archived_pointers",
    "documents",
    "dynamic_prefixes",
    "site_globs",
    "site_host",
    "stale_globs",
    "stale_terms"
  ]
}
