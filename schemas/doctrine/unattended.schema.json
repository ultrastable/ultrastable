{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/unattended.schema.json",
 "title": "doctrine/unattended.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "target": {
   "type": "object",
   "properties": {
    "statement": {
     "type": "string"
    },
    "metric": {
     "type": "string"
    },
    "op": {
     "type": "string"
    },
    "value": {
     "type": "number"
    },
    "set": {
     "type": "string"
    },
    "release_metric": {
     "type": "string"
    },
    "release_op": {
     "type": "string"
    },
    "release_value": {
     "type": "number"
    },
    "probe": {
     "type": "string"
    },
    "pillars": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "principle": {
     "type": "string"
    }
   }
  },
  "warn_days": {
   "type": "number"
  },
  "dependencies": {
   "type": "array",
   "items": {
    "type": "object"
   }
  }
 },
 "required": [
  "_doc",
  "dependencies",
  "target",
  "version",
  "warn_days"
 ]
}
