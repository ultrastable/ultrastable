       "type": "number"
      },
      "report_as_report": {
       "type": "number"
      },
      "horizon_advanced": {
       "type": "number"
      },
      "capability_gap_closed": {
       "type": "number"
      },
      "false_stop_eradicated": {
       "type": "number"
      },
      "objective_space_extended": {
       "type": "number"
      },
      "plateau_remediated": {
       "type": "number"
      },
      "doctrine_amendment_adopted": {
       "type": "number"
      },
      "friction_signal_closed": {
       "type": "number"
      },
      "inference_acted_on_correctly": {
       "type": "number"
      },
