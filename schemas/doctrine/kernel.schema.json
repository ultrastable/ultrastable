      "claim": {
       "type": "string"
      },
      "evidence": {
       "type": "string"
      }
     }
    }
   }
  }
 },
 "required": [
  "_doc",
  "commitments",
  "directives",
  "directives_text",
  "evidence_rules",
  "excused_by",
  "framing",
  "id",
  "lineage",
  "metrics",
  "recognitions",
  "text",
  "tick_states",
  "tick_steps",
  "trust",
  "version"
 ]
}
