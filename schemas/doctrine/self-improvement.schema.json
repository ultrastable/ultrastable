{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/self-improvement.schema.json",
 "title": "doctrine/self-improvement.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "id": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "marker": {
   "type": "string"
  },
  "axiom": {
   "type": "string"
  },
  "algorithm": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "params": {
   "type": "object",
   "properties": {
    "window_days": {
     "type": "number"
    },
    "cooldown_days": {
     "type": "number"
    },
    "explore_epsilon": {
     "type": "number"
    },
    "explore_pool": {
     "type": "number"
    },
    "explore_c": {
     "type": "number"
    },
    "min_effect": {
     "type": "number"
    },
    "guard_tolerance": {
     "type": "number"
    },
    "reinforce": {
     "type": "number"
    },
    "decay": {
     "type": "number"
    }
   }
  },
  "signals": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "guards": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "per_worker_contract": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "algorithm",
  "axiom",
  "guards",
  "id",
  "marker",
  "params",
  "per_worker_contract",
  "signals",
  "version"
 ]
}
