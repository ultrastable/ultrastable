{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/pathfinder.schema.json",
 "title": "doctrine/pathfinder.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "surface_classes": {
   "type": "object",
   "properties": {
    "existing-credentials": {
     "type": "string"
    },
    "prior-working-config": {
     "type": "string"
    },
    "sibling-workers": {
     "type": "string"
    },
    "alternate-channel": {
     "type": "string"
    },
    "construct": {
     "type": "string"
    }
   }
  },
  "route_kinds": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "asks": {
   "type": "object",
   "properties": {}
  },
  "integrations": {
   "type": "array"
  },
  "grandfathered_gates": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "derive": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "surfaces": {
     "type": "object",
     "properties": {
      "social_accounts": {
       "type": "object"
      },
      "cloudflare": {
       "type": "object"
      },
      "org_admin": {
       "type": "object"
      }
     }
    },
    "gate_asks": {
     "type": "object",
     "properties": {
      "owner-social": {
       "type": "string"
      },
      "owner-oauth-apps": {
       "type": "string"
      },
      "owner-domains-move": {
       "type": "string"
      },
      "SOC-ACCOUNTS": {
       "type": "string"
      },
      "CF-TOKEN": {
       "type": "string"
      },
      "ORG-TOKEN": {
       "type": "string"
      }
     }
    }
   }
  }
 },
 "required": [
  "_doc",
  "asks",
  "derive",
  "grandfathered_gates",
  "integrations",
  "route_kinds",
  "surface_classes",
  "version"
 ]
}
