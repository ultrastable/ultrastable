{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/rootcauses.schema.json",
 "title": "doctrine/rootcauses.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "window_days": {
   "type": "number"
  },
  "escalate_days": {
   "type": "number"
  },
  "quiet_days": {
   "type": "number"
  },
  "classes": {
   "type": "array",
   "items": {
    "type": "object"
   }
  }
 },
 "required": [
  "_doc",
  "classes",
  "escalate_days",
  "quiet_days",
  "version",
  "window_days"
 ]
}
