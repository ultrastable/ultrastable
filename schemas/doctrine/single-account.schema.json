{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/doctrine/single-account.schema.json",
 "title": "doctrine/single-account.json",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "required_account": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "id": {
     "type": "string"
    }
   }
  },
  "forbidden": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "skip_dirs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "allow": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "runtime": {
   "type": "object",
   "properties": {
    "_doc": {
     "type": "string"
    },
    "pattern": {
     "type": "string"
    },
    "globs": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "skip": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "allow": {
     "type": "array"
    }
   }
  }
 },
 "required": [
  "_doc",
  "allow",
  "forbidden",
  "required_account",
  "runtime",
  "skip_dirs",
  "version"
 ]
}
