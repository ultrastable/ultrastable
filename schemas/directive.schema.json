{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/directive.schema.json",
 "title": "directive.json",
 "description": "Inferred from directive.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "blocker_fields": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "control_dispositions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "dispositions": {
   "type": "object",
   "properties": {
    "backlogged": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "fixed": {
     "type": "array"
    },
    "superseded": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "doc_consumption": {
   "type": "object",
   "properties": {
    "check": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "owner_date": {
     "type": "string"
    },
    "registry": {
     "type": "string"
    },
    "rule": {
     "type": "string"
    }
   }
  },
  "durable_facts": {
   "type": "string"
  },
  "excused_by": {
   "type": "string"
  },
  "failure_mode_fields": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "id": {
   "type": "string"
  },
  "instruction_files": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "instruction_marker": {
   "type": "string"
  },
  "interrupt_eligible": {
   "type": "object",
   "properties": {
    "identity_bound": {
     "type": "boolean"
    },
    "reversible": {
     "type": "boolean"
    },
    "reversible_path_engineerable": {
     "type": "boolean"
    }
   }
  },
  "layers_on": {
   "type": "string"
  },
  "lint": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "means": {
      "type": "string"
     },
     "patterns": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "id",
     "means",
     "patterns"
    ]
   }
  },
  "loop_breaker": {
   "type": "object",
   "properties": {
    "incident_after": {
     "type": "integer"
    },
    "mutate_after": {
     "type": "integer"
    },
    "mutations": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "precedence": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "clause": {
      "type": "string"
     },
     "kernel": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "rank": {
      "type": "integer"
     }
    },
    "required": [
     "clause",
     "name",
     "rank"
    ]
   }
  },
  "provenance_fields": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "registers": {
   "type": "string"
  },
  "scorecard": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "formula": {
      "type": "string"
     },
     "headline": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "target": {
      "type": [
       "number",
       "string"
      ]
     }
    },
    "required": [
     "formula",
     "id",
     "target"
    ]
   }
  },
  "sections": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "seed_copy": {
   "type": "string"
  },
  "surfaces": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "text": {
   "type": "string"
  },
  "tie_break": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "blocker_fields",
  "control_dispositions",
  "dispositions",
  "doc_consumption",
  "durable_facts",
  "excused_by",
  "failure_mode_fields",
  "id",
  "instruction_files",
  "instruction_marker",
  "interrupt_eligible",
  "layers_on",
  "lint",
  "loop_breaker",
  "precedence",
  "provenance_fields",
  "registers",
  "scorecard",
  "sections",
  "seed_copy",
  "surfaces",
  "text",
  "tie_break",
  "version"
 ]
}
