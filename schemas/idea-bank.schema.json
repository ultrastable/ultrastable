{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/idea-bank.schema.json",
 "title": "idea-bank.json",
 "description": "Inferred from idea-bank.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "depth_fields": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "ideas": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "added": {
      "type": "string"
     },
     "budget": {
      "type": "integer"
     },
     "change": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "data": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "depth": {
      "type": "object",
      "properties": {
       "corpus": {
        "type": "string"
       },
       "method": {
        "type": "string"
       },
       "returns": {
        "type": "string"
       }
      },
      "required": [
       "corpus",
       "method",
       "returns"
      ]
     },
     "domain": {
      "type": "string"
     },
     "empowers": {
      "type": "string"
     },
     "hook": {
      "type": "string"
     },
     "horizon": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "id": {
      "type": "string"
     },
     "keywords": {
      "type": "string"
     },
     "loop": {
      "type": "string"
     },
     "measure": {
      "type": "string"
     },
     "reach": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "thesis": {
      "type": "string"
     },
     "upkeep": {
      "type": "string"
     }
    },
    "required": [
     "added",
     "budget",
     "change",
     "data",
     "depth",
     "domain",
     "empowers",
     "hook",
     "horizon",
     "id",
     "keywords",
     "loop",
     "measure",
     "reach",
     "text",
     "thesis",
     "upkeep"
    ]
   }
  },
  "max_active": {
   "type": "integer"
  },
  "max_per_domain": {
   "type": "integer"
  },
  "max_text": {
   "type": "integer"
  },
  "min_domains": {
   "type": "integer"
  },
  "narrow_phrases": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "owner_edits": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "after": {
      "type": "string"
     },
     "before": {
      "type": "string"
     },
     "date": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "lesson": {
      "type": "string"
     }
    }
   }
  },
  "refused_domains": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "retired": {
   "type": "array"
  }
 },
 "required": [
  "_doc",
  "depth_fields",
  "ideas",
  "max_active",
  "max_per_domain",
  "max_text",
  "min_domains",
  "narrow_phrases",
  "owner_edits",
  "refused_domains",
  "retired"
 ]
}
