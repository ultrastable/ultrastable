{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/providers.schema.json",
 "title": "providers.json",
 "description": "Inferred from providers.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "canonical": {
   "type": "object",
   "properties": {
    "code": {
     "type": "string"
    },
    "direction": {
     "type": "string"
    }
   }
  },
  "capabilities": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "layers": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "provider_specific": {
      "type": "boolean"
     },
     "what": {
      "type": "string"
     },
     "where": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "provider_specific",
     "what",
     "where"
    ]
   }
  },
  "providers": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "map": {
      "type": "object",
      "properties": {
       "git working copy and mirror": {
        "type": "string"
       },
       "http front door": {
        "type": "string"
       },
       "model inference": {
        "type": "string"
       },
       "object or key store": {
        "type": "string"
       },
       "relational store": {
        "type": "string"
       },
       "scheduler": {
        "type": "string"
       }
      }
     },
     "state": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "state"
    ]
   }
  },
  "self_hosting_test": {
   "type": "object",
   "properties": {
    "claim": {
     "type": "string"
    },
    "probe": {
     "type": "string"
    },
    "today": {
     "type": "string"
    },
    "true_when": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "canonical",
  "capabilities",
  "layers",
  "providers",
  "self_hosting_test",
  "version"
 ]
}
