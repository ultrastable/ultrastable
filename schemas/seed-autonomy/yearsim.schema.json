   "type": "string"
  },
  "seed": {
   "type": "string"
  },
  "runs": {
   "type": "number"
  },
  "days": {
   "type": "number"
  },
  "target_days": {
   "type": "number"
  },
  "fatal_floor": {
   "type": "number"
  },
  "fatal_after_days": {
   "type": "number"
  },
