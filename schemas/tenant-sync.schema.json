    ]
   }
  },
  "upstream_min_30d": {
   "type": "integer"
  }
 },
 "required": [
  "_doc",
  "core",
  "drift_max_days",
  "future_tenant_rule",
  "ledger",
  "max_prs_per_day",
  "repos",
  "upstream_min_30d"
 ]
}
