   "type": "string"
  },
  "core": {
   "type": "object",
   "properties": {
    "dir": {
     "type": "string"
    },
    "repo": {
     "type": "string"
    },
    "tool": {
     "type": "string"
    }
   }
  },
  "drift_max_days": {
