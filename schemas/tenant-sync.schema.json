   "type": "string"
  },
  "max_prs_per_day": {
   "type": "integer"
  },
  "repos": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "clone": {
      "type": "string"
     },
     "pr_repo": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "vendor_dir": {
      "type": "string"
     },
     "why": {
      "type": "string"
     }
    },
    "required": [
