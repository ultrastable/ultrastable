{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/tenant-sync.schema.json",
 "title": "tenant-sync.json",
 "description": "Inferred from tenant-sync.json; tighten by hand.",
 "type": "object",
 "properties": {
