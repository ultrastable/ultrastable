     "patterns",
     "roadmap",
     "weight"
    ]
   }
  },
  "id": {
   "type": "string"
  },
  "ingest": {
   "type": "string"
  },
  "issue_prefix": {
   "type": "string"
  },
  "mic_events": {
   "type": "object",
   "properties": {
    "codes": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string"
       },
       "roadmap": {
        "type": "string"
       },
       "weight": {
        "type": "integer"
       }
      },
      "required": [
       "kind",
       "roadmap",
       "weight"
      ]
