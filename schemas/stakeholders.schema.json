{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/stakeholders.schema.json",
 "title": "stakeholders.json",
 "description": "Inferred from stakeholders.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "audiences": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "cta": {
      "type": "object",
      "properties": {
       "href": {
        "type": "string"
       },
       "label": {
        "type": "string"
       }
      },
      "required": [
       "href",
       "label"
      ]
     },
     "domain": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "nav": {
      "type": "string"
     },
     "needs": {
      "type": "string"
     },
     "path": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "promise": {
      "type": "string"
     },
     "stories": {
      "type": "array",
      "items": {
       "type": "object"
      }
     }
    },
    "required": [
     "cta",
     "domain",
     "id",
     "name",
     "nav",
     "needs",
     "path",
     "promise",
     "stories"
    ]
   }
  },
  "domains": {
   "type": "object",
   "properties": {
    "io": {
     "type": "object",
     "properties": {
      "audiences": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "host": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     }
    },
    "org": {
     "type": "object",
     "properties": {
      "audiences": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "host": {
       "type": "string"
      },
      "live_home": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     }
    }
   }
  },
  "showcases": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "domain": {
      "type": "string"
     },
     "home": {
      "type": "string"
     },
     "homeLabel": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "learned": {
      "type": "string"
     },
     "links": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "loop": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "problem": {
      "type": "string"
     },
     "results": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "separate": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     },
     "tag": {
      "type": "string"
     }
    },
    "required": [
     "domain",
     "id",
     "learned",
     "links",
     "loop",
     "name",
     "problem",
     "results",
     "status",
     "summary",
     "tag"
    ]
   }
  }
 },
 "required": [
  "_doc",
  "audiences",
  "domains",
  "showcases"
 ]
}
