{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/pilot-model.schema.json",
 "title": "pilot-model.json",
 "description": "Inferred from pilot-model.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "decided": {
   "type": "string"
  },
  "decision": {
   "type": "string"
  },
  "hypotheses": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "claim": {
      "type": "string"
     },
     "closing_probe": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "test": {
      "type": "string"
     }
    },
    "required": [
     "claim",
     "closing_probe",
     "id",
     "test"
    ]
   }
  },
  "layers": {
   "type": "object",
   "properties": {
    "enforced_by": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "levels": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "exists": {
        "type": "boolean"
       },
       "level": {
        "type": "integer"
       },
       "name": {
        "type": "string"
       },
       "what": {
        "type": "string"
       }
      },
      "required": [
       "exists",
       "level",
       "name",
       "what"
      ]
     }
    },
    "roll_up": {
     "type": "string"
    },
    "rule": {
     "type": "string"
    },
    "tenancy": {
     "type": "string"
    },
    "title": {
     "type": "string"
    }
   }
  },
  "multi_tenant_obligations": {
   "type": "object",
   "properties": {
    "before_offering": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "closing_probe": {
     "type": "string"
    },
    "status": {
     "type": "string"
    }
   }
  },
  "options": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "our_data_burden": {
      "type": "string"
     },
     "revenue": {
      "type": "string"
     },
     "runs_on": {
      "type": "string"
     },
     "setup": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "our_data_burden",
     "revenue",
     "runs_on",
     "status"
    ]
   }
  },
  "pilot_proof_points": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "program": {
   "type": "object",
   "properties": {
    "apply_fields": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "intake_probe": {
     "type": "string"
    },
    "pitch": {
     "type": "string"
    },
    "price": {
     "type": "string"
    },
    "selection": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "title": {
     "type": "string"
    },
    "we_get": {
     "type": "string"
    },
    "you_get": {
     "type": "string"
    }
   }
  },
  "revert": {
   "type": "string"
  },
  "why": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "decided",
  "decision",
  "hypotheses",
  "layers",
  "multi_tenant_obligations",
  "options",
  "pilot_proof_points",
  "program",
  "revert",
  "why"
 ]
}
