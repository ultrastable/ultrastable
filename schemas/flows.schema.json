{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/flows.schema.json",
 "title": "flows.json",
 "description": "Inferred from flows.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "external_sources": {
   "type": "object",
   "properties": {
    "ext.actions_quota": {
     "type": "string"
    },
    "ext.app_users": {
     "type": "string"
    },
    "ext.cf_analytics": {
     "type": "string"
    },
    "ext.frontier": {
     "type": "string"
    },
    "ext.ledger_literature": {
     "type": "string"
    },
    "ext.outreach_replies": {
     "type": "string"
    },
    "ext.owner_goals": {
     "type": "string"
    },
    "ext.post_engagement": {
     "type": "string"
    },
    "ext.site_visits": {
     "type": "string"
    },
    "ext.unlearn_adults": {
     "type": "string"
    },
    "ext.unlearn_literature": {
     "type": "string"
    },
    "ext.unlearn_readers": {
     "type": "string"
    }
   }
  },
  "flows": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "bindings": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "feedback": {
      "type": "string"
     },
     "inflows": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "outflows": {
      "type": "array",
      "items": {
       "type": "object"
      }
     }
    },
    "required": [
     "feedback",
     "inflows",
     "outflows"
    ]
   }
  },
  "id": {
   "type": "string"
  },
  "implicit_producers": {
   "type": "object",
   "properties": {
    "actions.minutes": {
     "type": "string"
    },
    "app.metrics": {
     "type": "string"
    },
    "cf.analytics": {
     "type": "string"
    },
    "frontier.releases": {
     "type": "string"
    },
    "ledger.literature": {
     "type": "string"
    },
    "loop.registry": {
     "type": "string"
    },
    "owner.goals": {
     "type": "string"
    },
    "site.hits": {
     "type": "string"
    },
    "unlearn.followups": {
     "type": "string"
    },
    "unlearn.literature": {
     "type": "string"
    },
    "unlearn.reader_taps": {
     "type": "string"
    }
   }
  },
  "pending": {
   "type": "array"
  },
  "quote": {
   "type": "string"
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "external_sources",
  "flows",
  "id",
  "implicit_producers",
  "pending",
  "quote",
  "version"
 ]
}
