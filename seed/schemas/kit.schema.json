{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/seed/kit.schema.json",
 "title": "kit.json",
 "description": "Inferred from kit.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "components": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "covers": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "files": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "id": {
      "type": "string"
     },
     "probe": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "template": {
      "type": "object",
      "properties": {
       "from": {
        "type": "string"
       }
      },
      "required": [
       "from"
      ]
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "covers",
     "files",
     "id",
     "probe",
     "what"
    ]
   }
  },
  "max_age_days": {
   "type": "integer"
  },
  "required_faults": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "target_days": {
   "type": "integer"
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "_doc",
  "components",
  "max_age_days",
  "required_faults",
  "target_days",
  "version"
 ]
}
