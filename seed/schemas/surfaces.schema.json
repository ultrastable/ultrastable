{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/seed/surfaces.schema.json",
 "title": "surfaces.json",
 "description": "Inferred from surfaces.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "contract_version": {
   "type": "string"
  },
  "surfaces": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "audience": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "discoverable": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "methods": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "path": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "standards": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "audience",
     "description",
     "discoverable",
     "id",
     "kind",
     "methods",
     "path",
     "standards"
    ]
   }
  }
 },
 "required": [
  "_doc",
  "contract_version",
  "surfaces"
 ]
}
