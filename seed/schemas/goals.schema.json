{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/seed/goals.schema.json",
 "title": "goals.json",
 "description": "Inferred from goals.json; tighten by hand.",
 "type": "object",
 "properties": {
  "_doc": {
   "type": "string"
  },
  "control": {
   "type": "object",
   "properties": {
    "achieve_after": {
     "type": "integer"
    },
    "max_adjust_per_run": {
     "type": "integer"
    },
    "max_stretch_per_day": {
     "type": "integer"
    },
    "stale_days": {
     "type": "integer"
    }
   }
  },
  "goals": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "deadline": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "level": {
      "type": "string"
     },
     "op": {
      "type": "string"
     },
     "parent_id": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "spec": {
      "type": "string"
     },
     "statement": {
      "type": "string"
     },
     "target": {
      "type": "number"
     },
     "unit": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "level",
     "statement"
    ]
   }
  },
  "knobs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "config_path": {
      "type": "string"
     },
     "cooldown_h": {
      "type": "integer"
     },
     "effect": {
      "type": "integer"
     },
     "goal_id": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "max": {
      "type": "number"
     },
     "min": {
      "type": "number"
     },
     "review_h": {
      "type": "integer"
     },
     "step": {
      "type": "number"
     },
     "value": {
      "type": "number"
     },
     "what": {
      "type": "string"
     }
    },
    "required": [
     "cooldown_h",
     "effect",
     "goal_id",
     "id",
     "max",
     "min",
     "review_h",
     "step",
     "value",
     "what"
    ]
   }
  },
  "tenant_feeds": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "tenant": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    }
   }
  }
 },
 "required": [
  "_doc",
  "control",
  "goals",
  "knobs",
  "tenant_feeds"
 ]
}
