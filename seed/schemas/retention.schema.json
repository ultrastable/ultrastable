{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/seed/retention.schema.json",
 "title": "retention.json",
 "description": "Inferred from retention.json; tighten by hand.",
 "type": "object",
 "properties": {
  "doc": {
   "type": "string"
  },
  "max_rows_per_run": {
   "type": "integer"
  },
  "tables": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "archive": {
      "type": "boolean"
     },
     "column": {
      "type": "string"
     },
     "keep": {
      "type": "string"
     },
     "keep_days": {
      "type": "integer"
     },
     "reason": {
      "type": "string"
     },
     "unit": {
      "type": "string"
     }
    }
   }
  }
 },
 "required": [
  "doc",
  "max_rows_per_run",
  "tables"
 ]
}
