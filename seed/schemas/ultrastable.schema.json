{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/seed/ultrastable.schema.json",
 "title": "ultrastable.json",
 "description": "Inferred from ultrastable.json; tighten by hand.",
 "type": "object",
 "properties": {
  "$schema_version": {
   "type": "string"
  },
  "analytics": {
   "type": "object",
   "properties": {
    "beacon": {
     "type": "string"
    },
    "guard": {
     "type": "string"
    },
    "privacy": {
     "type": "string"
    },
    "report": {
     "type": "string"
    },
    "standard": {
     "type": "string"
    }
   }
  },
  "capacity": {
   "type": "object",
   "properties": {
    "fix_only_cycles_before_rebalance": {
     "type": "integer"
    },
    "growth_share_floor": {
     "type": "number"
    },
    "max_wip_per_role": {
     "type": "integer"
    },
    "plus_share": {
     "type": "number"
    }
   }
  },
  "connectors": {
   "type": "object",
   "properties": {
    "chat": {
     "type": "object",
     "properties": {
      "env": {
       "type": "string"
      },
      "optional": {
       "type": "boolean"
      },
      "required_for": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "cloudflare": {
     "type": "object",
     "properties": {
      "env": {
       "type": "string"
      },
      "required_for": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "cloudflare_account": {
     "type": "object",
     "properties": {
      "env": {
       "type": "string"
      },
      "required_for": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "github": {
     "type": "object",
     "properties": {
      "env": {
       "type": "string"
      },
      "required_for": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "model_api": {
     "type": "object",
     "properties": {
      "env": {
       "type": "string"
      },
      "required_for": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "model_ladder": {
   "type": "object",
   "properties": {
    "aliases": {
     "type": "object",
     "properties": {
      "large": {
       "type": "string"
      },
      "medium": {
       "type": "string"
      },
      "small": {
       "type": "string"
      }
     }
    },
    "note": {
     "type": "string"
    },
    "tiers": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "budget_usd_per_month_min": {
        "type": "integer"
       },
       "doer": {
        "type": "string"
       },
       "manager": {
        "type": "string"
       },
       "reviewer": {
        "type": "string"
       }
      },
      "required": [
       "budget_usd_per_month_min",
       "doer",
       "manager",
       "reviewer"
      ]
     }
    }
   }
  },
  "org": {
   "type": "object",
   "properties": {
    "repos": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "reporting": {
   "type": "object",
   "properties": {
    "format": {
     "type": "string"
    },
    "lines": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "roles": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "count": {
      "type": [
       "integer",
       "string"
      ]
     },
     "id": {
      "type": "string"
     },
     "instructions": {
      "type": "string"
     },
     "tick_every": {
      "type": "integer"
     }
    },
    "required": [
     "count",
     "id",
     "instructions",
     "tick_every"
    ]
   }
  },
  "runtime": {
   "type": "object",
   "properties": {
    "d1_database": {
     "type": "string"
    },
    "other_runtimes_supported_later": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "provider": {
     "type": "string"
    },
    "tick_cron": {
     "type": "string"
    },
    "worker_name": {
     "type": "string"
    }
   }
  }
 },
 "required": [
  "$schema_version",
  "analytics",
  "capacity",
  "connectors",
  "model_ladder",
  "org",
  "reporting",
  "roles",
  "runtime"
 ]
}
