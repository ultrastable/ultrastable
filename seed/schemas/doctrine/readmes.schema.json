{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./doctrine/readmes.schema.json",
  "$comment": "inferred by scripts/schemas.py (OPEN-STANDARDS-1); edit freely, --gen never overwrites",
  "title": "doctrine/readmes.json",
  "type": "object",
  "properties": {
    "_doc": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_host": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_globs": {
      "type": "array"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sections": {
            "type": "array"
          }
        },
        "required": [
          "path",
          "sections"
        ]
      }
    }
  },
  "required": [
    "_doc",
    "documents",
    "site_globs",
    "site_host"
  ]
}
