{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/constitution.schema.json",
  "title": "Ultrastable constitution",
  "type": "object",
  "required": [
    "id",
    "version",
    "statement",
    "identity",
    "run_loop",
    "bootstrap",
    "autonomy_ladder",
    "criticality",
    "rules"
  ],
  "properties": {
    "id": {
      "const": "constitution"
    },
    "version": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "source",
          "detector",
          "remediation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "rule": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "detector": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "remediation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  }
}
