      "properties": {
        "tla-aws": {
          "type": "string"
        },
        "sel4": {
          "type": "string"
        },
        "compcert": {
          "type": "string"
        },
        "power-of-ten": {
          "type": "string"
        },
        "do-178c": {
          "type": "string"
        },
        "quickcheck": {
          "type": "string"
        },
        "ashby": {
          "type": "string"
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "source": {
            "type": "array"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
