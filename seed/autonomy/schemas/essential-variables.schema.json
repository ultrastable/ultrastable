{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/seed/autonomy/essential-variables.schema.json",
  "title": "essential-variables (seed/autonomy/essential-variables.json)",
  "description": "Contract for seed/autonomy/essential-variables.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "limit": {
            "type": "number"
          },
          "metric": {
            "type": "string"
          },
          "op": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "variables"
  ]
}
