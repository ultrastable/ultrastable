{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/seed/autonomy/repo-conformance.schema.json",
  "title": "repo-conformance (seed/autonomy/repo-conformance.json)",
  "description": "Contract for seed/autonomy/repo-conformance.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number"
    },
    "about": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contains": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "about",
    "files",
    "version"
  ]
}
