{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/surfaces.schema.json",
 "title": "HTTP surfaces the seed Worker serves",
 "type": "object",
 "required": [
  "contract_version",
  "surfaces"
 ],
 "properties": {
  "contract_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "surfaces": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "path",
     "methods",
     "kind",
     "audience",
     "standards",
     "discoverable",
     "description"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "path": {
      "type": "string",
      "pattern": "^/"
     },
     "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
       ]
      }
     },
     "kind": {
      "enum": [
       "rest",
       "discovery",
       "ui",
       "analytics",
       "mcp"
      ]
     },
     "audience": {
      "enum": [
       "public",
       "owner",
       "machine",
       "agent"
      ]
     },
     "standards": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9-]+$"
      }
     },
     "discoverable": {
      "type": "boolean"
     },
     "description": {
      "type": "string",
      "minLength": 1
     },
     "reason": {
      "type": "string"
     }
    }
   }
  }
 }
}
