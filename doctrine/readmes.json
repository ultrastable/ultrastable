{
  "_doc": "DOCS-SYNC-1 (Rowan, 2026-11-21): every public document is complete and matches the code; front end matches back end in every system and tenant. Consumer: scripts/check_readmes.py (checks workflow; seed/scripts/check_readmes.py in every seeded system).",
  "site_host": "ultrastable.io",
  "site_globs": [
    "site/*.js"
  ],
  "documents": [
    {
      "path": "README.md",
      "sections": [
        "Why Ultrastable exists",
        "Vision",
        "The name: Ashby's ultrastable system",
        "How it works",
        "Architecture",
        "See it live",
        "Getting started",
        "Repository map",
        "Status",
        "Ultrastable License",
        "Contributing and security"
      ]
    },
    {
      "path": "seed/README.md",
      "sections": []
    }
  ],
  "dynamic_prefixes": [
    "/assets",
    "/s/",
    "/for/",
    "/showcase/",
    "/digest/"
  ],
  "stale_globs": [
    "README.md",
    "site/*.js"
  ],
  "stale_terms": [
    {
      "pattern": "^(?!.*(?i:retired|archived|moved)).*github\\.com/ultrastable/(workers|spec|license|seed)\\b",
      "why": "links a retired repository as if it were live; its contents are in ultrastable/ultrastable"
    },
    {
      "pattern": "(?i)three simple screens",
      "why": "old product framing replaced by the interview front door"
    },
    {
      "pattern": "(?i)file (the|a) provisional",
      "why": "no patent filing: the license is the only protection"
    }
  ],
  "archived_pointers": [
    {
      "repo": "ultrastable/license",
      "must_point_to": "github.com/ultrastable/ultrastable",
      "must_not_point_to": [
        "# Moved: ultrastable/spec"
      ]
    },
    {
      "repo": "ultrastable/spec",
      "must_point_to": "github.com/ultrastable/ultrastable"
    },
    {
      "repo": "ultrastable/workers",
      "must_point_to": "github.com/ultrastable/ultrastable"
    }
  ]
}
