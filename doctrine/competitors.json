     "kind": "page"
    }
   ]
  },
  {
   "id": "app-builders",
   "name": "Lovable, Bolt.new, v0, Replit, Base44",
   "sources": [
    {
     "url": "https://www.ionos.com/digitalguide/websites/web-development/best-ai-app-builder.md",
     "kind": "page"
    }
   ]
  },
  {
   "id": "factory",
   "name": "Factory",
   "sources": [
    {
     "url": "https://factory.com/news/factory-is-ga",
     "kind": "page"
    }
   ]
  },
  {
   "id": "openai-codex",
   "name": "OpenAI Codex",
   "sources": [
    {
     "url": "https://github.com/openai/codex/releases.atom",
     "kind": "atom"
    }
   ]
  },
  {
   "id": "openhands",
   "name": "OpenHands",
   "sources": [
    {
     "url": "https://github.com/All-Hands-AI/OpenHands/releases.atom",
     "kind": "atom"
    }
   ]
  },
  {
   "id": "langgraph",
   "name": "LangGraph",
   "sources": [
    {
     "url": "https://github.com/langchain-ai/langgraph/releases.atom",
     "kind": "atom"
    }
   ]
  },
  {
   "id": "greptile",
   "name": "Greptile",
   "sources": [
    {
     "url": "https://www.greptile.com/",
     "kind": "page"
    },
    {
     "url": "https://www.greptile.com/open-source",
     "kind": "page"
    }
   ],
   "plug_in": {
    "role": "reviewer",
    "status": "staged",
    "cost": "paid per seat; free program is for open-source projects, and our repos are source-available, not OSI open source, so we likely do not qualify",
    "default": "in-repo reviewer and red-team checks in the merge lane",
    "probe": "grep:.github/workflows/checks.yml::greptile",
    "source": "https://www.greptile.com/open-source"
   }
  },
  {
   "id": "coderabbit",
   "name": "CodeRabbit",
   "sources": [
    {
     "url": "https://docs.coderabbit.ai/management/plans",
     "kind": "page"
    }
   ],
   "plug_in": {
    "role": "reviewer",
    "status": "staged",
    "cost": "free Pro plan is offered to open-source projects; eligibility for a source-available licence is unconfirmed",
    "default": "in-repo reviewer and red-team checks in the merge lane",
    "probe": "file:.coderabbit.yaml",
    "source": "https://docs.coderabbit.ai/management/plans"
   }
  },
  {
   "id": "devin",
   "name": "Devin (Cognition)",
   "sources": [
    {
     "url": "https://www.cognition.ai/blog/new-self-serve-plans-for-devin",
     "kind": "page"
    }
   ],
   "plug_in": {
    "role": "executor",
    "status": "declined",
    "cost": "paid self-serve plans; no free tier found",
    "default": "own executor on free models",
    "probe": "grep:foundation/agents.py::devin",
    "source": "https://www.cognition.ai/blog/new-self-serve-plans-for-devin",
    "reason": "no free tier; revisit when one exists"
   }
  }
 ],
 "_plug_in_doc": "BORROW-1 (Rowan, 2026-11-26): where a competitor does one step better than we do, plug it in as a worker instead of rebuilding it. A competitor's plug_in names the role it would fill, its status (staged until an account exists, live once a probe shows it running, declined with a reason), the default in effect meanwhile (always our own worker, so nothing waits) and a file:/grep: probe that passes only when it is wired in. Free tiers only, or cost inside the soft daily throttle. rnd --check validates every row."
}
