{
 "_doc": "RULES-1 (Rowan, 2026-11-18): every standing rule is enforced by deployed code, never by words. This is the one machine-readable registry. Each rule names the CI checks that fail a change (cmd must appear in a workflow file) and the runtime probes the tick runs on main (`python3 -m foundation rules --run --apply`): a violation files one Q-RULE item with the probe as its done check and runs the declared fix. A rule with no CI check, no runtime probe, or an unfiled gap fails `python3 -m foundation rules --check`. Status is published on the owner ops view (dashboard snapshot panel `rules`). Consumers: foundation/rules.py, scripts/dashboard_snapshot.py, scripts/lane.sh, .github/workflows/checks.yml.",
 "version": "1.0.0",
 "workflows": [
  ".github/workflows/checks.yml"
 ],
 "interval_h": 6,
 "rules": [
  {
   "id": "closed-loops",
   "statement": "Every open item has an owner, a trigger and a closing probe; every loop closes itself (CLOSED-LOOP-1, SERVER-OWNS-LOOPS-1).",
   "source": "agents/AGENTS.md; doctrine/closed-loop.json",
   "ci": [
    {
     "cmd": "python3 -m foundation closedloop --check"
    },
    {
     "cmd": "python3 -m foundation loopowner --check"
    },
    {
     "cmd": "python3 -m foundation queue --check"
    }
   ],
   "runtime": [
    {
     "id": "closedloop",
     "cmd": "python3 -m foundation closedloop --check"
    },
    {
     "id": "item-fields",
     "cmd": "python3 -m foundation queue --check"
    },
    {
     "id": "loop-owner",
     "cmd": "python3 -m foundation loopowner --check"
    }
   ]
  },
  {
   "id": "autonomy-first",
   "statement": "No decision, question or step is handed to the owner; agents decide, deploy and verify (GUIDING-DIRECTIVE, CODE-ONLY-ORDER).",
   "source": "docs/doctrine/GUIDING-DIRECTIVE.md; doctrine/standing-order.json",
   "ci": [
    {
     "cmd": "python3 -m foundation standingorder --check"
    },
    {
     "cmd": "python3 -m foundation directive --check"
    }
   ],
   "runtime": [
    {
     "id": "standing-order",
     "cmd": "python3 -m foundation standingorder --check",
     "fix": "python3 -m foundation standingorder --file-items"
    },
    {
     "id": "directive",
     "cmd": "python3 -m foundation directive --check"
    }
   ]
  },
  {
   "id": "front-end-matches-back-end",
   "statement": "Words match code: every public statement is bound to a probe of the running code (CLAIMS-1, WORDS-MATCH-CODE-1).",
   "source": "doctrine/claims.json; doctrine/claim-code.json",
   "ci": [
    {
     "cmd": "python3 -m foundation claims --check"
    },
    {
     "cmd": "python3 -m foundation claimcode --check"
    }
   ],
   "runtime": [
    {
     "id": "claims",
     "cmd": "python3 -m foundation claims --check"
    },
    {
     "id": "claimcode",
     "cmd": "python3 -m foundation claimcode --check"
    },
    {
     "id": "pages-live",
     "cmd": "python3 -m foundation rules --probe pages-live"
    },
    {
     "id": "spinoff-live",
     "cmd": "python3 -m foundation rules --probe spinoff-live"
    }
   ],
   "gaps": [
    {
     "what": "Practical Solutions *.gen.js bundles do not yet report freshness",
     "item": "Q-RULE-gap-pages-audit"
    }
   ]
  },
  {
   "id": "no-merge-over-red",
   "statement": "A PR merges only on a green full `checks` run; a merge that skipped it is filed and fixed (MERGE-AUDIT-1, LANE-1).",
   "source": "foundation/mergeaudit.py; scripts/lane.sh",
   "ci": [
    {
     "cmd": "python3 -m foundation mergeaudit --check"
    },
    {
     "cmd": "python3 -m foundation ciwatch --check"
    }
   ],
   "runtime": [
    {
     "id": "mergeaudit",
     "cmd": "python3 -m foundation rules --probe merged-green",
     "needs_network": true
    },
    {
     "id": "ciwatch",
     "cmd": "python3 -m foundation ciwatch --check"
    }
   ]
  },
  {
   "id": "free-tier",
   "statement": "Ultrastable stays inside the free plans; every workflow declares a minute budget; spend is measured (FREE-TIER-1, cost, actions budget).",
   "source": "doctrine/cost.json; seed/worker/src/budget.js; scripts/lint_workflows.py",
   "ci": [
    {
     "cmd": "python3 -m foundation cost --check"
    },
    {
     "cmd": "python3 scripts/lint_workflows.py"
    }
   ],
   "runtime": [
    {
     "id": "cost",
     "cmd": "python3 -m foundation cost --check"
    },
    {
     "id": "ideas-headroom",
     "cmd": "python3 -m foundation ideas --check"
    },
    {
     "id": "workflow-budgets",
     "cmd": "python3 scripts/lint_workflows.py"
    }
   ]
  },
  {
   "id": "no-qnfo-on-pages",
   "statement": "No QNFO data on Ultrastable pages: the brand and its data stay separate (shrink-only baseline per page source).",
   "source": "doctrine/rules-baseline.json",
   "ci": [
    {
     "cmd": "python3 -m foundation rules --probe no-qnfo-pages"
    }
   ],
   "runtime": [
    {
     "id": "no-qnfo-pages",
     "cmd": "python3 -m foundation rules --probe no-qnfo-pages"
    },
    {
     "id": "qnfo-live",
     "cmd": "python3 -m foundation rules --probe qnfo-live"
    }
   ]
  },
  {
   "id": "license-notice",
   "statement": "Every repository carries the LICENSE and the README license notice (IP protection is the license only).",
   "source": "scripts/check_license.py; scripts/check_org_repos.py",
   "ci": [
    {
     "cmd": "python3 scripts/check_license.py"
    },
    {
     "cmd": "python3 scripts/check_org_repos.py"
    }
   ],
   "runtime": [
    {
     "id": "license-local",
     "cmd": "python3 scripts/check_license.py"
    },
    {
     "id": "license-fleet",
     "cmd": "python3 -m foundation rules --probe license-notice",
     "needs_network": true
    }
   ]
  },
  {
   "id": "no-secrets-in-logs",
   "statement": "No secret value in a committed file, ledger or log; secrets are referenced by binding name only.",
   "source": "agents/AGENTS.md (never handle secret values)",
   "ci": [
    {
     "cmd": "python3 -m foundation rules --probe no-secrets"
    }
   ],
   "runtime": [
    {
     "id": "no-secrets",
     "cmd": "python3 -m foundation rules --probe no-secrets"
    }
   ]
  },
  {
   "id": "server-side-only",
   "statement": "Every loop runs server-side; nothing depends on a person's computer (SERVER-SIDE ONLY).",
   "source": "doctrine/server-side.json",
   "ci": [
    {
     "cmd": "python3 -m foundation serverside --check"
    }
   ],
   "runtime": [
    {
     "id": "serverside",
     "cmd": "python3 -m foundation serverside --check"
    }
   ]
  },
  {
   "id": "clock-never-stops",
   "statement": "Every clock is probed, a stopped one is restarted, no single point of failure (RESILIENCE-1, CLOCKWORK-1).",
   "source": "doctrine/resilience.json; doctrine/clocks.json",
   "ci": [
    {
     "cmd": "python3 -m foundation resilience --check"
    },
    {
     "cmd": "python3 -m foundation clock --check"
    }
   ],
   "runtime": [
    {
     "id": "resilience",
     "cmd": "python3 -m foundation resilience --check"
    },
    {
     "id": "clock",
     "cmd": "python3 -m foundation clock --check"
    }
   ]
  },
  {
   "id": "user-backend-boundary",
   "statement": "Users see their idea and front end; backend work stays invisible, audited and in shared code (USER-BACKEND-1, POINT-AND-CLICK-1).",
   "source": "doctrine/user-backend.json; doctrine/point-and-click.json",
   "ci": [
    {
     "cmd": "python3 -m foundation userbackend --check"
    },
    {
     "cmd": "python3 -m foundation pointclick --check"
    }
   ],
   "runtime": [
    {
     "id": "userbackend",
     "cmd": "python3 -m foundation userbackend --check"
    },
    {
     "id": "pointclick",
     "cmd": "python3 -m foundation pointclick --check"
    }
   ]
  },
  {
   "id": "every-decision-measured",
   "statement": "Every autonomous decision records the metric it optimizes, its predicted effect and the measured outcome, and the outcomes are scored (DECISIONS-1: measure what we improve, improve what we measure).",
   "source": "doctrine/decisions.json; agents/AGENTS.md",
   "ci": [
    {
     "cmd": "python3 -m foundation decisions --check"
    }
   ],
   "runtime": [
    {
     "id": "decisions-scored",
     "cmd": "python3 -m foundation decisions --probe",
     "needs_network": true,
     "fix": "python3 -m foundation decisions --settle --apply"
    }
   ]
  },
  {
   "id": "single-account",
   "statement": "Ultrastable runs only in the Cloudflare account `ultrastable`; nothing in the repositories references the retired quniverse account or its Ultrastable assets (SINGLE-ACCOUNT-1).",
   "source": "doctrine/single-account.json",
   "ci": [
    {
     "cmd": "python3 -m foundation singleaccount --check"
    }
   ],
   "runtime": [
    {
     "id": "singleaccount",
     "cmd": "python3 -m foundation singleaccount --check"
    }
   ]
  },
  {
   "id": "every-goal-has-knob",
   "statement": "Every goal Ultrastable works toward has a measured variable, a target, a deadline and at least one knob the controller may turn; a goal with no knob is listed in a shrink-only baseline and filed as a backlog item (GOALS-1).",
   "source": "seed/autonomy/goals.json",
   "ci": [
    {
     "cmd": "python3 -m foundation goalscheck --check"
    }
   ],
   "runtime": [
    {
     "id": "goalscheck",
     "cmd": "python3 -m foundation goalscheck --check"
    }
   ]
  },
  {
   "id": "no-open-items",
   "statement": "The system never reports 'needs you' or leaves an item open: every leftover is closed by evidence or recorded as a gate with surfaces tried, a default in effect and a closing probe (NO-OPEN-ITEMS-1).",
   "source": "doctrine/open-loops.json",
   "ci": [
    {
     "cmd": "python3 -m foundation openloops --check"
    }
   ],
   "runtime": [
    {
     "id": "openloops",
     "cmd": "python3 -m foundation openloops --check"
    },
    {
     "id": "modelwatch",
     "cmd": "python3 -m foundation modelwatch --check",
     "fix": "python3 -m foundation modelwatch --refresh --apply"
    },
    {
     "id": "unattended",
     "cmd": "python3 -m foundation unattended --check"
    }
   ]
  },
  {
   "id": "held-out-rescoring",
   "statement": "Every settled prediction is re-scored by graders that share no code with the scorer (a strict rule and a second model family); a disagreement files its own item (RESCORE-1).",
   "source": "foundation/rescore.py; doctrine/decisions.json",
   "ci": [
    {
     "cmd": "python3 -m foundation rescore --check"
    }
   ],
   "runtime": [
    {
     "id": "rescored",
     "cmd": "python3 -m foundation rescore --check",
     "fix": "python3 -m foundation rescore --run --apply"
    }
   ]
  },
  {
   "id": "own-database",
   "statement": "The core's databases are its own: no core Worker binds a tenant's database or a database of the originating fleet, and the declared core databases exist in the core's account (OWN-DB-1).",
   "source": "instances/ultrastable/own-database.json",
   "ci": [
    {
     "cmd": "python3 -m foundation owndb --check"
    }
   ],
   "runtime": [
    {
     "id": "owndb-live",
     "cmd": "python3 -m foundation owndb --live",
     "needs_network": true
    }
   ]
  },
  {
   "id": "hosted-tier-closed-until-proven",
   "statement": "The multi-tenant hosted tier is not offered while any of its controls is unproven; each control's status is the result of its probes (TENANT-CONTROLS-1).",
   "source": "doctrine/tenant-controls.json; doctrine/pilot-model.json",
   "ci": [
    {
     "cmd": "python3 -m foundation tenantcontrols --check"
    }
   ],
   "runtime": [
    {
     "id": "tenantcontrols",
     "cmd": "python3 -m foundation tenantcontrols --check",
     "fix": "python3 -m foundation tenantcontrols --write"
    }
   ]
  },
  {
   "id": "visible-progress",
   "statement": "Every system shows noticeable, substantive progress at every visit for at least six months with no input: what shipped is published from merged changes, releases and launches only, and a system that falls behind its declared cadence has its producers started and a repair item filed (PROGRESS-1).",
   "source": "instances/ultrastable/progress.json",
   "ci": [
    {
     "cmd": "python3 -m foundation progress --check"
    }
   ],
   "runtime": [
    {
     "id": "progress",
     "cmd": "python3 -m foundation progress --check"
    },
    {
     "id": "progress-apps",
     "cmd": "python3 -m foundation progress --apps",
     "fix": "python3 -m foundation ideas --brainstorm --apply"
    },
    {
     "id": "progress-live",
     "cmd": "python3 -m foundation progress --live",
     "needs_network": true
    }
   ]
  },
  {
   "id": "human-voice",
   "statement": "Everything written for people reads like a person wrote it: every prose model call carries the shared voice and is rewritten when it reads as AI, the social publisher and thought posts block AI-sounding text, and public surfaces may only get better (HUMAN-VOICE-1).",
   "source": "agents/AGENTS.md; doctrine/human-voice.json; seed/worker/src/humanvoice.js",
   "ci": [
    {
     "cmd": "python3 -m foundation humanvoice --check"
    }
   ],
   "runtime": [
    {
     "id": "human-voice",
     "cmd": "python3 -m foundation humanvoice --check",
     "fix": "python3 -m foundation humanvoice --report --apply"
    }
   ]
  }
 ],
 "repos": [
  "ultrastable",
  "seed",
  "workers",
  "spec",
  "license",
  "ops",
  "practical-solutions",
  ".github"
 ],
 "org": "ultrastable",
 "notice_pattern": "Ultrastable License|USL-1\\.0",
 "secret_patterns": [
  "ghp_[A-Za-z0-9]{30,}",
  "github_pat_[A-Za-z0-9_]{30,}",
  "sk-ant-[A-Za-z0-9_-]{30,}",
  "AKIA[0-9A-Z]{16}",
  "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
  "xox[abp]-[A-Za-z0-9-]{20,}"
 ],
 "secret_exempt_globs": [
  "tests/**",
  "**/test/**",
  "**/*.test.*",
  "docs/doctrine/**",
  "doctrine/rules.json",
  "foundation/rules.py",
  "workers/**",
  "seed/worker/src/auth/**"
 ],
 "qnfo_scan_globs": [
  "site/*.js",
  "site/*.json",
  "site/*.html",
  "public/**/*.html",
  "public/**/*.js",
  "dashboard/worker.js"
 ],
 "qnfo_exempt_globs": [
  "site/*.test.mjs",
  "site/STAGED-COPY.md"
 ],
 "qnfo_live_origin": "https://ultrastable.io",
 "qnfo_live_pages": [
  "/",
  "/live",
  "/how",
  "/roadmap",
  "/claims",
  "/self",
  "/ultrastability",
  "/decisions",
  "/showcase",
  "/changelog",
  "/api/live/changes"
 ],
 "pages_live_urls": [
  "https://ultrastable.io/api/freshness",
  "https://tenant-ps-web.ultrastable.workers.dev/api/freshness"
 ]
}
