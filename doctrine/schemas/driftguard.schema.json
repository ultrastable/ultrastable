{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/driftguard.schema.json",
  "title": "driftguard (doctrine/driftguard.json)",
  "description": "Contract for doctrine/driftguard.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "cron_budget": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "limits": {
          "type": "object"
        },
        "headroom": {
          "type": "number"
        },
        "external": {
          "type": "object"
        },
        "pulse_external": {
          "type": "array"
        }
      }
    },
    "missed_trigger": {
      "type": "object",
      "properties": {
        "window_hours": {
          "type": "number"
        },
        "grace_minutes": {
          "type": "number"
        }
      }
    },
    "empty_loop": {
      "type": "object",
      "properties": {
        "max_empty_per_branch": {
          "type": "number"
        }
      }
    },
    "account_drift": {
      "type": "object",
      "properties": {
        "retired_account_sha256": {
          "type": "array"
        }
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "code": {
            "type": "array"
          },
          "detector": {
            "type": "string"
          },
          "failure_mode": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "root_cause": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "account_drift",
    "cron_budget",
    "empty_loop",
    "incidents",
    "missed_trigger",
    "version"
  ]
}
