{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/unattended.schema.json",
  "title": "unattended (doctrine/unattended.json)",
  "description": "Contract for doctrine/unattended.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "set": {
          "type": "string"
        },
        "release_metric": {
          "type": "string"
        },
        "release_op": {
          "type": "string"
        },
        "release_value": {
          "type": "number"
        },
        "probe": {
          "type": "string"
        },
        "pillars": {
          "type": "array"
        },
        "principle": {
          "type": "string"
        }
      }
    },
    "warn_days": {
      "type": "number"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string"
          },
          "connect": {
            "type": "string"
          },
          "default": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "measured": {
            "type": "string"
          },
          "needs_you": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          },
          "renewal": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "dependencies",
    "target",
    "version",
    "warn_days"
  ]
}
