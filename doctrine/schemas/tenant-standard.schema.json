{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/tenant-standard.schema.json",
 "title": "Tenant standard (TENANT-STANDARD-1)",
 "type": "object",
 "required": [
  "rule",
  "version",
  "core_repo",
  "bootstrap_url",
  "positioning",
  "files",
  "live",
  "identity",
  "survival",
  "package",
  "vendor",
  "workflows",
  "scaffold"
 ],
 "properties": {
  "rule": {
   "type": "string",
   "pattern": "^[A-Z][A-Z0-9-]+-\\d+$"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "core_repo": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
  },
  "bootstrap_url": {
   "type": "string",
   "pattern": "^https://[^\\s]+$"
  },
  "positioning": {
   "type": "string",
   "minLength": 1
  },
  "files": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "path",
     "why"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "path": {
      "type": "string",
      "minLength": 1
     },
     "contains": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "why": {
      "type": "string",
      "minLength": 1
     }
    }
   },
   "minItems": 1
  },
  "live": {
   "type": "object",
   "required": [
    "platform",
    "links",
    "undeployed"
   ],
   "properties": {
    "platform": {
     "type": "string",
     "pattern": "^https://[^\\s]+$"
    },
    "links": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "undeployed": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "identity": {
   "type": "object",
   "required": [
    "keys"
   ],
   "properties": {
    "keys": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1,
     "uniqueItems": true
    }
   }
  },
  "survival": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9-]*$"
   },
   "minItems": 13,
   "uniqueItems": true
  },
  "package": {
   "type": "object",
   "required": [
    "dependencies",
    "why"
   ],
   "properties": {
    "dependencies": {
     "type": "string",
     "minLength": 1
    },
    "why": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "vendor": {
   "type": "object",
   "required": [
    "dir",
    "base",
    "rule"
   ],
   "properties": {
    "rule": {
     "type": "string",
     "minLength": 1
    },
    "dir": {
     "type": "string",
     "minLength": 1
    },
    "base": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "workflows": {
   "type": "object",
   "required": [
    "header",
    "needs",
    "pins",
    "runner"
   ],
   "properties": {
    "pins": {
     "type": "string",
     "minLength": 1
    },
    "runner": {
     "type": "string",
     "minLength": 1
    },
    "header": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^# [a-z-]+:$"
     }
    },
    "needs": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "scaffold": {
   "type": "object",
   "required": [
    "dir",
    "files",
    "defaults"
   ],
   "properties": {
    "dir": {
     "type": "string",
     "minLength": 1
    },
    "files": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "generated": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "defaults": {
     "type": "object",
     "required": [
      "beat_hours",
      "noun",
      "host",
      "compatibility_date"
     ],
     "properties": {
      "noun": {
       "type": "string",
       "minLength": 1
      },
      "beat_hours": {
       "type": "integer",
       "minimum": 1
      },
      "host": {
       "type": "string",
       "pattern": "\\{slug\\}"
      },
      "compatibility_date": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
     }
    }
   }
  }
 }
}
