{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/kernel-9.schema.json",
  "title": "kernel-9 (doctrine/kernel-9.json)",
  "description": "Contract for doctrine/kernel-9.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "lock": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enforced_by": {
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "missing": {
            "type": "string"
          },
          "says": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "active",
    "clauses",
    "lock",
    "source",
    "supersedes",
    "text",
    "version"
  ]
}
