{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/credwatch.schema.json",
  "title": "credwatch (doctrine/credwatch.json)",
  "description": "Contract for doctrine/credwatch.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "warn_days": {
      "type": "number"
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "used_by": {
            "type": "string"
          }
        }
      }
    },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "auto_renew": {
            "type": "boolean"
          },
          "expires": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "credentials",
    "registrations",
    "version",
    "warn_days"
  ]
}
