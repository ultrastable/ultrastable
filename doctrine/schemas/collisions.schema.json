{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/collisions.schema.json",
  "title": "collisions (doctrine/collisions.json)",
  "description": "Contract for doctrine/collisions.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "baseline_duplicates": {
      "type": "object",
      "properties": {
        "seed/worker/migrations": {
          "type": "array"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "baseline_duplicates",
    "rule"
  ]
}
