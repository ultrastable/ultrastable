{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/lessons.schema.json",
  "title": "lessons (doctrine/lessons.json)",
  "description": "Contract for doctrine/lessons.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enforced_by": {
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "lesson": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "id",
    "lessons"
  ]
}
