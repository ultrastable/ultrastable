{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/tenant-repos.schema.json",
  "title": "tenant-repos (doctrine/tenant-repos.json)",
  "description": "Contract for doctrine/tenant-repos.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "tenants": {
      "type": "object",
      "properties": {
        "practical-solutions": {
          "type": "object"
        },
        "unlearn": {
          "type": "object"
        },
        "what-works": {
          "type": "object"
        },
        "replication-ledger": {
          "type": "object"
        },
        "base-rates": {
          "type": "object"
        },
        "did-it-work": {
          "type": "object"
        },
        "open-questions": {
          "type": "object"
        },
        "spinoffs": {
          "type": "object"
        }
      }
    },
    "visitor_apps": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "repo_prefix": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "base_manifest": {
          "type": "string"
        },
        "usd_per_month": {
          "type": "number"
        },
        "max_apps": {
          "type": "number"
        },
        "max_deploys_per_run": {
          "type": "number"
        },
        "full_stack_hours": {
          "type": "number"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "org",
    "tenants",
    "visitor_apps"
  ]
}
