{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/deprot.schema.json",
  "title": "deprot (doctrine/deprot.json)",
  "description": "Contract for doctrine/deprot.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "baseline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "directory": {
            "type": "string"
          },
          "ecosystem": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "baseline"
  ]
}
