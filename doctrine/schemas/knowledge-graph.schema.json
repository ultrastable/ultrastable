{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/knowledge-graph.schema.json",
  "title": "knowledge-graph (doctrine/knowledge-graph.json)",
  "description": "Contract for doctrine/knowledge-graph.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "core_module": {
      "type": "string"
    },
    "seed_vendor": {
      "type": "string"
    },
    "seed_step": {
      "type": "string"
    },
    "migration": {
      "type": "string"
    },
    "tenant_vendor_path": {
      "type": "string"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "systems": {
      "type": "object",
      "properties": {
        "ultrastable": {
          "type": "object"
        },
        "practical-solutions": {
          "type": "object"
        },
        "unlearn": {
          "type": "object"
        },
        "what-works": {
          "type": "object"
        },
        "replication-ledger": {
          "type": "object"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "core_module",
    "endpoints",
    "migration",
    "rule",
    "rule_files",
    "seed_step",
    "seed_vendor",
    "systems",
    "tenant_vendor_path"
  ]
}
