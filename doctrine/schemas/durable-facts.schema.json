{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/durable-facts.schema.json",
  "title": "durable-facts (doctrine/durable-facts.json)",
  "description": "Contract for doctrine/durable-facts.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "also": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "facts",
    "version"
  ]
}
