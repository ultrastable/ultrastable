{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/replay-set.schema.json",
  "title": "replay-set (doctrine/replay-set.json)",
  "description": "Contract for doctrine/replay-set.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "interval_days": {
      "type": "number"
    },
    "min_saving": {
      "type": "number"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "keywords": {
            "type": "array"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "interval_days",
    "min_saving",
    "questions"
  ]
}
