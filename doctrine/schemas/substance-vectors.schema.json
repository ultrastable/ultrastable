{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/substance-vectors.schema.json",
  "title": "substance-vectors (doctrine/substance-vectors.json)",
  "description": "Contract for doctrine/substance-vectors.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "added": {
            "type": "array"
          },
          "expect": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "removed": {
            "type": "array"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expect": {
            "type": "string"
          },
          "kinds": {
            "type": "array"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "cases",
    "verdicts"
  ]
}
