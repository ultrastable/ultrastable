{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/conclusions.schema.json",
  "title": "conclusions (doctrine/conclusions.json)",
  "description": "Contract for doctrine/conclusions.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "key": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "entries"
  ]
}
