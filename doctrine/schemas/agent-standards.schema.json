{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/agent-standards.schema.json",
  "title": "agent-standards (doctrine/agent-standards.json)",
  "description": "Contract for doctrine/agent-standards.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "marker": {
      "type": "string"
    },
    "marker_text": {
      "type": "string"
    },
    "instruction_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          },
          "proof": {
            "type": "string"
          },
          "read": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "instruction_files",
    "marker",
    "marker_text",
    "standards"
  ]
}
