{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/static-content.schema.json",
  "title": "static-content (doctrine/static-content.json)",
  "description": "Contract for doctrine/static-content.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "marker": {
      "type": "string"
    },
    "max_unchanged_days": {
      "type": "number"
    },
    "max_pages": {
      "type": "number"
    },
    "exempt": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "exempt",
    "marker",
    "max_pages",
    "max_unchanged_days"
  ]
}
