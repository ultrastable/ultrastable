{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/state-sink.schema.json",
  "title": "state-sink (doctrine/state-sink.json)",
  "description": "Contract for doctrine/state-sink.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "areas": {
      "type": "object",
      "properties": {
        "outreach/packets": {
          "type": "object"
        },
        "docs/issues": {
          "type": "object"
        },
        "ops": {
          "type": "object"
        }
      }
    },
    "ratchet": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "armed_when_share_at_most": {
          "type": "number"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "areas",
    "ratchet"
  ]
}
