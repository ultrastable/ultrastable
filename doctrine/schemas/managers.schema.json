{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/managers.schema.json",
  "title": "managers (doctrine/managers.json)",
  "description": "Contract for doctrine/managers.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "marker": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "seed_register": {
      "type": "string"
    },
    "live": {
      "type": "object",
      "properties": {
        "agents_url": {
          "type": "string"
        },
        "user_agent": {
          "type": "string"
        },
        "timeout_s": {
          "type": "number"
        }
      }
    },
    "seed_absent": {
      "type": "object",
      "properties": {}
    },
    "platform_absent": {
      "type": "object",
      "properties": {}
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "runs",
          "clock",
          "probe",
          "settles",
          "human_role",
          "decides",
          "inputs",
          "hands_to",
          "cadence"
        ],
        "properties": {
          "human_role": {
            "type": "string",
            "minLength": 1
          },
          "decides": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hands_to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cadence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "closure": {
      "type": "object",
      "properties": {
        "min_ended": {
          "type": "number"
        },
        "max_shelved_share": {
          "type": "number"
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "software_roles": {
      "type": "array",
      "minItems": 22,
      "items": {
        "type": "object",
        "required": [
          "id",
          "function",
          "status",
          "roles",
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "covered",
              "gap"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dedicated": {
            "type": "string"
          },
          "item": {
            "type": "string",
            "pattern": "^Q-ROLE-[A-Za-z0-9-]+$"
          },
          "missing": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "_doc",
    "closure",
    "live",
    "marker",
    "platform_absent",
    "roles",
    "seed_absent",
    "seed_register",
    "software_roles",
    "version"
  ]
}
