{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/readmes.schema.json",
  "title": "readmes (doctrine/readmes.json)",
  "description": "Contract for doctrine/readmes.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "site_host": {
      "type": "string"
    },
    "site_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dynamic_prefixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "archived_pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "must_point_to": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "archived_pointers",
    "documents",
    "dynamic_prefixes",
    "site_globs",
    "site_host",
    "stale_globs",
    "stale_terms"
  ]
}
