{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/claim-code.schema.json",
  "title": "claim-code (doctrine/claim-code.json)",
  "description": "Contract for doctrine/claim-code.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "scan_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skip": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_len": {
      "type": "number"
    },
    "claim_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "probe": {
            "type": "object"
          },
          "quote": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "baseline": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closing_probe": {
      "type": "string"
    },
    "skip_reasons": {
      "type": "object",
      "properties": {
        "self-data\\.js": {
          "type": "string"
        },
        "research-data\\.js": {
          "type": "string"
        },
        "temporal-data\\.js": {
          "type": "string"
        },
        "yearfail-data\\.js": {
          "type": "string"
        },
        "saydo-data\\.js": {
          "type": "string"
        },
        "yearsim-data\\.js": {
          "type": "string"
        },
        "trajectory-data\\.js": {
          "type": "string"
        },
        "intent-yield-data\\.js": {
          "type": "string"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "baseline",
    "claim_patterns",
    "claims",
    "closing_probe",
    "id",
    "min_len",
    "owner",
    "rule",
    "scan_globs",
    "skip",
    "skip_reasons"
  ]
}
