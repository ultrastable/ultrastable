{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/rules.schema.json",
  "title": "rules (doctrine/rules.json)",
  "description": "Contract for doctrine/rules.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interval_h": {
      "type": "number"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ci": {
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "runtime": {
            "type": "array"
          },
          "source": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "org": {
      "type": "string"
    },
    "notice_pattern": {
      "type": "string"
    },
    "secret_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "secret_exempt_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qnfo_scan_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qnfo_exempt_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qnfo_live_origin": {
      "type": "string"
    },
    "qnfo_live_pages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pages_live_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "interval_h",
    "notice_pattern",
    "org",
    "pages_live_urls",
    "qnfo_exempt_globs",
    "qnfo_live_origin",
    "qnfo_live_pages",
    "qnfo_scan_globs",
    "repos",
    "rules",
    "secret_exempt_globs",
    "secret_patterns",
    "version",
    "workflows"
  ]
}
