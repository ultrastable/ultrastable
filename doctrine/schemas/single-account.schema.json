{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/single-account.schema.json",
  "title": "single-account (doctrine/single-account.json)",
  "description": "Contract for doctrine/single-account.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "required_account": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        }
      }
    },
    "skip_dirs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "globs": {
          "type": "array"
        },
        "skip": {
          "type": "array"
        },
        "allow": {
          "type": "array"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "allow",
    "forbidden",
    "required_account",
    "runtime",
    "skip_dirs",
    "version"
  ]
}
