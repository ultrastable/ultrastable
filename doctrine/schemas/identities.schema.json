{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/identities.schema.json",
  "title": "identities (doctrine/identities.json)",
  "description": "Contract for doctrine/identities.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "identities": {
      "type": "object",
      "properties": {
        "merge": {
          "type": "object"
        },
        "agent": {
          "type": "object"
        },
        "administration": {
          "type": "object"
        }
      }
    },
    "top_level_write": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "identities",
    "top_level_write"
  ]
}
