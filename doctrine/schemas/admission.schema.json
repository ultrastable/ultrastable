{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/admission.schema.json",
  "title": "admission (doctrine/admission.json)",
  "description": "Contract for doctrine/admission.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "live_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "rule_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "live_states",
    "registries",
    "rule_files",
    "version"
  ]
}
