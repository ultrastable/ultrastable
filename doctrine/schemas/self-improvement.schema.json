{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/self-improvement.schema.json",
  "title": "self-improvement (doctrine/self-improvement.json)",
  "description": "Contract for doctrine/self-improvement.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "marker": {
      "type": "string"
    },
    "axiom": {
      "type": "string"
    },
    "algorithm": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "params": {
      "type": "object",
      "properties": {
        "window_days": {
          "type": "number"
        },
        "cooldown_days": {
          "type": "number"
        },
        "explore_epsilon": {
          "type": "number"
        },
        "explore_pool": {
          "type": "number"
        },
        "explore_c": {
          "type": "number"
        },
        "min_effect": {
          "type": "number"
        },
        "guard_tolerance": {
          "type": "number"
        },
        "reinforce": {
          "type": "number"
        },
        "decay": {
          "type": "number"
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "better": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "consumer": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          }
        }
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "per_worker_contract": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "algorithm",
    "axiom",
    "guards",
    "id",
    "marker",
    "params",
    "per_worker_contract",
    "signals",
    "version"
  ]
}
