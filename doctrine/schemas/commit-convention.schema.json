{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/commit-convention.schema.json",
 "title": "Commit title convention for generated commits (Conventional Commits 1.0.0 header)",
 "type": "object",
 "required": [
  "spec",
  "generators",
  "baseline_ceiling",
  "baseline"
 ],
 "additionalProperties": false,
 "patternProperties": {
  "^_": true
 },
 "properties": {
  "spec": {
   "type": "string",
   "pattern": "^https://www\\.conventionalcommits\\.org/"
  },
  "generators": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "baseline_ceiling": {
   "type": "integer",
   "minimum": 0
  },
  "baseline": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[^:]+: .+"
   }
  }
 }
}
