{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/promotion.schema.json",
  "title": "promotion (doctrine/promotion.json)",
  "description": "Contract for doctrine/promotion.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "weights_file": {
      "type": "string"
    },
    "outcomes_file": {
      "type": "string"
    },
    "plan_file": {
      "type": "string"
    },
    "gates_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "audience": {
            "type": "string"
          },
          "consumer": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "gate": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "needs": {
            "type": "string"
          },
          "reach": {
            "type": "number"
          },
          "requires": {
            "type": "array"
          },
          "route": {
            "type": "string"
          },
          "signal": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "channels",
    "gates_allowed",
    "outcomes_file",
    "plan_file",
    "weights_file"
  ]
}
