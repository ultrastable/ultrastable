{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrastable.io/schemas/doctrine/registers.schema.json",
  "title": "registers (doctrine/registers.json)",
  "description": "Contract for doctrine/registers.json. Generated as a floor by `python3 -m foundation configschema --gen`; tighten it by hand, it is never overwritten.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "spofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "second_path_exercised": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blast_radius": {
            "type": "string"
          },
          "cadence_ticks": {
            "type": "number"
          },
          "detection": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "root_cause": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "symptom": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alternate": {
            "type": "string"
          },
          "critical_path": {
            "type": "boolean"
          },
          "disposition": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "_doc",
    "controls",
    "failure_modes",
    "spofs",
    "version"
  ]
}
