      "bindings": []
    },
    "promote": {
      "inflows": [
        {
          "signal": "promotion.outcomes",
          "via": "file:ops/promotion/outcomes.jsonl"
        },
        {
          "signal": "outreach.replies",
          "via": "file:outreach/state.json"
        }
      ],
      "outflows": [
        {
          "signal": "promotion.outcomes",
          "via": "file:ops/promotion/outcomes.jsonl"
        },
        {
          "signal": "issue.filed",
          "via": "github:issues"
        }
      ],
      "feedback": "each recorded outcome (listed, replied, accepted, rejected, silent) moves its channel's weight in ops/promotion/weights.json, so the next plan ranks channels by what returned; a fact that changes (licence, public repo, entity) moves a programme in or out of fit by itself",
      "bindings": []
    },
    "blindspots": {
      "inflows": [
        {
          "signal": "blindspot.answers",
          "via": "file:ops/blindspots/answers.jsonl"
        }
      ],
      "outflows": [
        {
          "signal": "blindspot.answers",
          "via": "file:ops/blindspots/answers.jsonl"
        },
        {
          "signal": "issue.filed",
          "via": "github:issues"
        }
      ],
      "feedback": "each recorded sweep answer resets its domain's clock and each learned need extends the register, so the next scan asks about what the last one found; a failed probe files its own item and passes when the work lands",
      "bindings": []
    },
    "insight-loop": {
      "inflows": [
        {
          "signal": "site.hits",
          "via": "d1:ultrastable-org"
        },
        {
          "signal": "insight.ledger",
          "via": "file:ops/insight/findings.json"
        }
      ],
      "outflows": [
        {
          "signal": "issue.filed",
          "via": "github:issues"
        },
        {
          "signal": "insight.ledger",
          "via": "file:ops/insight/findings.json"
        }
      ],
      "feedback": "each finding is settled 8 days later against what the page really got; the outcome tunes the rise threshold that classifies the next findings",
      "bindings": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "LANE_PAT"
      ]
    },
    "criticality-loop": {
      "inflows": [
        {
          "signal": "deploys.record",
          "via": "d1:outcomes"
        },
        {
          "signal": "cost.readings",
          "via": "d1:criticality_samples"
        }
      ],
      "outflows": [
        {
          "signal": "criticality.k",
          "via": "d1:criticality_history"
        },
        {
          "signal": "backlog.ranked",
          "via": "d1:items"
        }
      ],
      "feedback": "the lever changes which item each role takes next tick; the next measured k_eff grades the logged prediction, and a miss reverts the lever and files CRIT-LEVER",
      "bindings": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN"
      ]
    }
  },
  "implicit_producers": {
