        {
          "signal": "metric.readings",
          "via": "d1:ultrastable-org"
        },
        {
          "signal": "scout.log",
          "via": "file:ops/scout/log.jsonl"
        },
        {
          "signal": "rnd.log",
          "via": "file:ops/rnd/log.jsonl"
