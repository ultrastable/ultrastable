{
 "_doc": "TRIGGERS-1: how the system wakes. TIME = one cron heartbeat on the host; every role ticks at tick_every x base interval (seed/worker/src/tick.js). EVENT = a signed GitHub webhook to /hook/github, or repository_dispatch wake:<role>, wakes one role out of turn. workflows is generated by `python3 -m foundation triggers --sync` and checked for drift by --check. Changed by reviewed PR.",
 "heartbeat": {
  "cron": "*/10 * * * *",
  "why": "one cron instead of one per role: Cloudflare limits crons per worker, and tick_every already gives each role its own cadence"
 },
 "host_limits": {
  "min_interval_minutes": 1,
  "max_crons_per_worker": 5,
  "max_ticks_per_day": 288,
  "max_role_period_minutes": 1440
 },
 "workflow_max_fires_per_day": 1,
 "events": [
  {
   "id": "issue-opened",
   "event": "issues",
   "actions": [
    "opened",
    "reopened"
   ],
   "role": "project-manager",
   "why": "new work is claimed and dispatched at once, not at the next heartbeat"
  },
  {
   "id": "issue-comment",
   "event": "issue_comment",
   "actions": [
    "created"
   ],
   "role": "project-manager",
   "why": "a reply on a claimed item unblocks it"
  },
  {
   "id": "pr-needs-review",
   "event": "pull_request",
   "actions": [
    "opened",
    "synchronize",
    "ready_for_review"
   ],
   "role": "reviewer",
   "why": "a different agent reviews every change"
  },
  {
   "id": "pr-merged",
   "event": "pull_request",
   "actions": [
    "closed"
   ],
   "when": "merged",
   "role": "operations",
   "why": "merge to deploy to verify-live"
  },
  {
   "id": "push-main",
   "event": "push",
   "when": "default-branch",
   "role": "operations",
   "why": "deploy and probe after every change to main"
  },
  {
   "id": "ci-failed",
   "event": "workflow_run",
   "actions": [
    "completed"
   ],
   "when": "failed",
   "role": "operations",
   "why": "a failing run becomes an incident with an owner"
  },
  {
   "id": "release-published",
   "event": "release",
   "actions": [
    "published"
   ],
   "role": "marketing-manager",
   "why": "a release is a content item"
  },
  {
   "id": "research-queued",
   "event": "repository_dispatch",
   "actions": [
    "research-queued"
   ],
   "role": "research-publisher",
   "why": "queued research starts now"
  },
  {
   "id": "disclosure-check",
   "event": "repository_dispatch",
   "actions": [
    "disclosure-check"
   ],
   "role": "legal-ip-manager",
   "why": "anything about to go public is checked first"
  },
  {
   "id": "support-request",
   "event": "repository_dispatch",
   "actions": [
    "support-request"
   ],
   "role": "customer-success",
   "why": "an instance asking for help is answered from the record"
  },
  {
   "id": "manifest-changed",
   "event": "repository_dispatch",
   "actions": [
    "manifest-changed"
   ],
   "role": "org-designer",
   "why": "a changed instance manifest changes which roles it needs"
  },
  {
   "id": "objective-changed",
   "event": "repository_dispatch",
   "actions": [
    "objective-changed"
   ],
   "role": "portfolio-manager",
   "why": "capacity is re-set when an objective changes"
  }
 ],
