{
 "_doc": "SEED-LIFECYCLE-1 answers for did-it-work; scaffolded by foundation/seedlife.py, completed by the executor through Q-SEED-did-it-work.",
 "slug": "did-it-work",
 "build": {
  "paths": [
   "instances/did-it-work/worker/index.js",
   "instances/did-it-work/worker/cases.js"
  ],
  "tests": [
   "instances/did-it-work/worker/worker.test.mjs"
  ]
 },
 "deploy": {
  "worker": "ultrastable-did-it-work"
 },
 "verify": {
  "url": "https://did-it-work.ultrastable.org/health",
  "expect": "\"app\":\"did-it-work\""
 },
 "loops": [
  "daily source check (cron 17 6 * * *)"
 ],
 "survival": {
  "credentials": {
   "inherit": "cloudflare-api-tokens"
  },
  "source-control": {
   "inherit": "github-app-token"
  },
  "budget": {
   "inherit": "workers-free-tier"
  },
  "cost-alerts": {
   "inherit": "cloudflare-alerts"
  },
  "payment": {
   "inherit": "payment-method"
  },
  "dependencies": {
   "inherit": "dependency-drift"
  },
  "runtime": {
   "inherit": "node-runtime"
  },
  "models": {
   "inherit": "workers-ai-models"
  },
  "health": {
   "status": "closed",
   "probe": "cmd:python3 -m foundation seedlife --verify",
   "how": "the watchdog fetches the verify URL every pass; a failing reading reopens Q-SEED and the handoff closer rolls back"
  },
  "backups": {
   "inherit": "offsite-backup"
  },
  "renewal": {
   "inherit": "domain-renewal"
  },
  "improvement": {
   "inherit": "self-coder"
  },
  "privacy": {
   "status": "closed",
   "probe": "file:instances/did-it-work/worker/index.js",
   "how": "no accounts, cookies or trackers; guesses are stored as per-case counts only"
  }
 }
}
