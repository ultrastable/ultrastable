{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ultrastable.io/schemas/runway.schema.json",
 "title": "Seed runway: instances/<slug>/runway.json (RUNWAY-1)",
 "type": "object",
 "required": [
  "target_days",
  "risks",
  "owner_only"
 ],
 "properties": {
  "target_days": {
   "type": "integer",
   "minimum": 365
  },
  "risks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "what",
     "safeguard",
     "probe"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "what": {
      "type": "string",
      "minLength": 1
     },
     "safeguard": {
      "type": "string",
      "minLength": 1
     },
     "probe": {
      "type": "string",
      "minLength": 1
     }
    }
   },
   "minItems": 1
  },
  "owner_only": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "what",
     "default_in_effect"
    ],
    "properties": {
     "what": {
      "type": "string",
      "minLength": 1
     },
     "default_in_effect": {
      "type": "string",
      "minLength": 1
     },
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     }
    }
   }
  }
 }
}
