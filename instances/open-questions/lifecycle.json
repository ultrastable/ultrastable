{
 "_doc": "SEED-LIFECYCLE-1 answers for open-questions; scaffolded by foundation/seedlife.py, completed by the executor through Q-SEED-open-questions.",
 "slug": "open-questions",
 "build": {
  "repo": "ultrastable/open-questions",
  "paths": [
   "worker/index.js",
   "worker/site.js",
   "worker/contract.js",
   "worker/entries.js"
  ],
  "tests": [
   "worker/worker.test.mjs",
   "worker/contract.test.mjs"
  ]
 },
 "deploy": {
  "worker": "ultrastable-open-questions"
 },
 "verify": {
  "url": "https://open-questions.ultrastable.org/health",
  "expect": "\"clock\""
 },
 "loops": [],
 "survival": {
  "credentials": {
   "inherit": "cloudflare-api-tokens"
  },
  "source-control": {
   "inherit": "github-app-token"
  },
  "budget": {
   "inherit": "workers-free-tier"
  },
  "cost-alerts": {
   "inherit": "cloudflare-alerts"
  },
  "payment": {
   "inherit": "payment-method"
  },
  "dependencies": {
   "inherit": "dependency-drift"
  },
  "runtime": {
   "inherit": "node-runtime"
  },
  "models": {
   "inherit": "workers-ai-models"
  },
  "health": {
   "status": "closed",
   "probe": "cmd:python3 -m foundation seedlife --verify",
   "how": "the watchdog fetches the verify URL every pass; a failing reading reopens Q-SEED and the handoff closer rolls back"
  },
  "backups": {
   "inherit": "offsite-backup"
  },
  "renewal": {
   "inherit": "domain-renewal"
  },
  "improvement": {
   "inherit": "self-coder"
  },
  "privacy": {
   "status": "open",
   "item": "Q-SEED-open-questions"
  }
 }
}
