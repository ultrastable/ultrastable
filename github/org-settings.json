  "manual_ui_only": [
    {
      "item": "Org avatar",
      "file": "brand/logo/ultrastable-icon-512.png",
      "where": "github.com/organizations/ultrastable/settings/profile",
      "probe": "avatar URL differs from the identicon"
    },
    {
      "item": "Repo social preview",
      "file": "brand/social/social-card.png",
      "where": "repo Settings > General > Social preview (no API exists)",
      "probe": "opengraph.githubassets.com card shows the custom image"
    },
    {
      "item": "Pinned repositories on the org page",
      "where": "org page > Customize pins (no REST API)",
      "probe": "org page lists the pinned repo"
    },
    {
      "item": "Verified domains ultrastable.io, .app, .net",
      "where": "org Settings > Verified and approved domains (TXT record, then verify)",
      "probe": "domains show Verified"
    },
    {
      "item": "Org-wide 2FA requirement",
      "where": "org Settings > Authentication security (no API)",
      "probe": "setting shows required"
    }
  ],
  "_plan_gated": "members_can_create_public_repositories=false, secret scanning on private repos and branch protection on private repos need a paid GitHub plan (or a public repo); the merge lane's required checks enforce the rule instead. Upgrading is a money step: owner card."
