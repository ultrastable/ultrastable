{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Ultrastable platform",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "postCreateCommand": "pip install --user pyyaml jsonschema && (cd seed/worker && npm install --no-audit --no-fund)",
  "customizations": {
    "codespaces": { "openFiles": ["AGENTS.md"] },
    "vscode": { "settings": { "json.schemaDownload.enable": true } }
  }
}
